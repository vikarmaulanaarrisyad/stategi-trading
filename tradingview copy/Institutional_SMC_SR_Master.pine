//@version=6
indicator('Institutional SMC & S/R Master [XAUUSD Pro]', shorttitle = 'SMC & S/R Master', overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

//+------------------------------------------------------------------+
//|                      PENGATURAN & INPUT USER                     |
//+------------------------------------------------------------------+

// --- GROUP 0: TRIPLE EXPONENTIAL MOVING AVERAGE (EMA 8, 21, 125) ---
grp_ema = '0. TRIPLE EXPONENTIAL MOVING AVERAGE (8, 21, 125)'
showEMA         = input.bool(true, 'Tampilkan Garis Triple EMA', group = grp_ema)
lenEMA1         = input.int(8, 'Fast EMA Period', minval = 1, group = grp_ema)
lenEMA2         = input.int(21, 'Medium EMA Period', minval = 1, group = grp_ema)
lenEMA3         = input.int(125, 'Baseline Trend EMA Period', minval = 1, group = grp_ema)
colorEMA1       = input.color(color.new(#00e5ff, 0), 'Warna Fast EMA 8 (Cyan)', group = grp_ema)
colorEMA2       = input.color(color.new(#ffd600, 0), 'Warna Medium EMA 21 (Kuning)', group = grp_ema)
colorEMA3       = input.color(color.new(#9c27b0, 0), 'Warna Trend EMA 125 (Ungu)', group = grp_ema)
showEMARibbon   = input.bool(true, 'Tampilkan Ribbon Cloud (EMA 8 - 21)', group = grp_ema)

// --- GROUP 0B: MULTI-TIMEFRAME (MTF) SCALPING TREND BIAS (H1/H4) ---
grp_mtf = '0B. MULTI-TIMEFRAME (MTF) SCALPING BIAS (H1/H4)'
useHtfFilter    = input.bool(true, 'Wajib Searah Tren H1/H4 (MTF Scalping Filter)', group = grp_mtf)
htfTimeframe    = input.timeframe('60', 'Timeframe Tren Utama HTF (Default: H1 / 60)', group = grp_mtf)

// --- GROUP 1: SUPPORT & RESISTANCE DINAMIS REALTIME ---
grp_sr = '1. SUPPORT & RESISTANCE (REALTIME DYNAMIC)'
showSR          = input.bool(true, 'Tampilkan Garis Support & Resistance', group = grp_sr)
srFilterMode    = input.string('Tampilkan S/R Terdekat & Terkuat', 'Filter Level S/R', options = ['Tampilkan S/R Terdekat & Terkuat', 'Hanya S/R Terdekat (Minor Terdekat)', 'Hanya S/R Terkuat (Major)'], group = grp_sr)
srExtendModel   = input.string('Extend Right', 'Model Jangkauan Garis S/R', options = ['Extend Right', 'Full Screen (Both)', 'None'], group = grp_sr)
srTrackPrice    = input.bool(false, 'Tampilkan Garis Tangga Historis (Track Price Trail)', group = grp_sr)
srLabelOffset   = input.int(25, 'Jarak Label S/R ke Kanan Lilin (Offset)', minval = 5, maxval = 80, group = grp_sr)
srLengthMajor   = input.int(15, 'Lookback Major S/R (Kekuatan Level)', minval = 5, group = grp_sr)
srLengthMinor   = input.int(5, 'Lookback Minor S/R (Level Terdekat)', minval = 2, group = grp_sr)
colorResistance = input.color(color.new(#f23645, 0), 'Warna Resistance (Merah)', group = grp_sr)
colorSupport    = input.color(color.new(#089981, 0), 'Warna Support (Hijau)', group = grp_sr)
lineWidthSR     = input.int(2, 'Ketebalan Garis S/R', minval = 1, maxval = 4, group = grp_sr)
showSRLabels    = input.bool(true, 'Tampilkan Label Harga S/R di Kanan', group = grp_sr)
showRBS_SBR     = input.bool(true, 'Tampilkan Garis & Label RBS / SBR (Role Reversal)', group = grp_sr)
colorRBS        = input.color(color.new(#00e5ff, 0), 'Warna Garis RBS (Cyan/Support Baru)', group = grp_sr)
colorSBR        = input.color(color.new(#ff9100, 0), 'Warna Garis SBR (Oranye/Resistance Baru)', group = grp_sr)

// --- GROUP 2: AUTO FIBONACCI GOLDEN ZONE ---
grp_fibo = '2. AUTO FIBONACCI GOLDEN ZONE (0.50 - 0.65 OTE)'
showFibo          = input.bool(true, 'Tampilkan Auto Fibonacci Golden Zone', group = grp_fibo)
fiboDirectionMode = input.string('Otomatis Adaptif (CHoCH & Gelombang M5)', 'Arah Realtime Fibo (BUY / SELL)', options = ['Otomatis Adaptif (CHoCH & Gelombang M5)', 'Otomatis Selaras HTF Bias (H1/H4)', 'Khusus SELL Zone (Koreksi Naik / Rebound)', 'Khusus BUY Zone (Koreksi Turun / Dip)', 'Mengikuti Ayunan M5 Terakhir'], group = grp_fibo)
fiboExtendModel   = input.string('Extend Right', 'Model Jangkauan Golden Zone', options = ['Extend Right', 'None'], group = grp_fibo)
fiboLength        = input.int(25, 'Lookback Dealing Range Fibonacci', minval = 5, group = grp_fibo)
showFiboLabels    = input.bool(true, 'Tampilkan Label Rasio Emas', group = grp_fibo)

// --- GROUP 3: MARKET STRUCTURE (BOS & CHOCH) ---
grp_ms = '3. STRUKTUR PASAR (BOS & CHOCH)'
showStructure   = input.bool(true, 'Tampilkan BOS & CHoCH', group = grp_ms)
structLookback  = input.int(5, 'Lookback Swing Structure', minval = 2, group = grp_ms)
showSwingLabels = input.bool(true, 'Tampilkan Label Swing (HH, HL, LH, LL)', group = grp_ms)
colorBullStruct = input.color(color.new(#00e676, 0), 'Warna Bullish Structure', group = grp_ms)
colorBearStruct = input.color(color.new(#ff1744, 0), 'Warna Bearish Structure', group = grp_ms)

// --- GROUP 3B: LIQUIDITAS INSTITUSIONAL (IDM & SSS SWEEP) ---
grp_liq = '3B. LIQUIDITAS INSTITUSIONAL (IDM & SSS SWEEP)'
showLiquidity   = input.bool(true, 'Tampilkan Inducement (IDM) & SSS Sweep', group = grp_liq)
showIDMLine     = input.bool(true, 'Tampilkan Garis Inducement (IDM)', group = grp_liq)
showSSSSweep    = input.bool(true, 'Tampilkan Label SSS (BSL/SSL Stop Run)', group = grp_liq)
idmPullbackLen  = input.int(2, 'Lookback Internal Pullback (IDM)', minval = 1, maxval = 6, group = grp_liq)
colorIDM        = input.color(color.new(#fbbf24, 0), 'Warna Level IDM (Emas)', group = grp_liq)
colorBSLSweep   = input.color(color.new(#ef4444, 0), 'Warna BSL Sweep (Merah)', group = grp_liq)
colorSSLSweep   = input.color(color.new(#10b981, 0), 'Warna SSL Sweep (Hijau)', group = grp_liq)

// --- GROUP 4: ORDER BLOCK (OB) ---
grp_ob = '4. INSTITUTIONAL ORDER BLOCK (OB)'
showOB           = input.bool(true, 'Tampilkan Zona Order Block (OB)', group = grp_ob)
obStrictFilter   = input.bool(true, 'Hanya Tandai OB Valid A+ (Wajib FVG / Sweep + Breakout)', group = grp_ob)
obDisplayMode    = input.string('1 Terdekat (1 Demand + 1 Supply Terdekat)', 'Pilihan Tampilan OB', options = ['1 Terdekat (1 Demand + 1 Supply Terdekat)', '1 Terbaru (Lilin Paling Baru)', 'Semua Zona Aktif'], group = grp_ob)
colorBullOB      = input.color(color.new(#00bcd4, 75), 'Warna Bullish OB (Demand)', group = grp_ob)
colorBearOB      = input.color(color.new(#e91e63, 75), 'Warna Bearish OB (Supply)', group = grp_ob)
borderBullOB     = input.color(color.new(#00bcd4, 20), 'Garis Tepi Bullish OB', group = grp_ob)
borderBearOB     = input.color(color.new(#e91e63, 20), 'Garis Tepi Bearish OB', group = grp_ob)
hideMitigatedOB  = input.bool(true, 'Hapus OB yang Sudah Termitigasi', group = grp_ob)
showOBLabels     = input.bool(true, 'Tampilkan Keterangan Teks di Kotak OB (Huruf Kecil)', group = grp_ob)

// --- GROUP 5: FAIR VALUE GAP (FVG / IMBALANCE) ---
grp_fvg = '5. FAIR VALUE GAP (FVG / IMBALANCE)'
showFVG          = input.bool(true, 'Tampilkan Fair Value Gap (FVG)', group = grp_fvg)
fvgStrictFilter  = input.bool(true, 'Hanya Tandai FVG Valid (Wajib Lilin Impulsif Kuat)', group = grp_fvg)
fvgDisplayMode   = input.string('1 Terdekat (1 Bull + 1 Bear Terdekat)', 'Pilihan Tampilan FVG', options = ['1 Terdekat (1 Bull + 1 Bear Terdekat)', '1 Terbaru (Paling Baru)', 'Semua Gap Aktif', 'Nonaktifkan'], group = grp_fvg)
fvgMinTicks      = input.int(20, 'Minimal Ukuran FVG (Ticks/Points)', minval = 1, group = grp_fvg)
fvgMinAtrPercent = input.float(0.20, 'Minimal Lebar Gap FVG (x ATR)', minval = 0.05, step = 0.05, group = grp_fvg)
colorBullFVG     = input.color(color.new(#10b981, 80), 'Warna Bullish FVG', group = grp_fvg)
colorBearFVG     = input.color(color.new(#ef4444, 80), 'Warna Bearish FVG', group = grp_fvg)
hideMitigatedFVG = input.bool(true, 'Hapus FVG yang Sudah Tertutup (Filled)', group = grp_fvg)
showFVGLabels    = input.bool(true, 'Tampilkan Keterangan Teks di Kotak FVG (Huruf Kecil)', group = grp_fvg)

// --- GROUP 6: HUD DASHBOARD TABLE ---
grp_hud = '6. HUD DASHBOARD ON-CHART'
showDashboard = input.bool(true, 'Tampilkan Tabel HUD Dashboard', group = grp_hud)
dashPosition  = input.string('Top Left', 'Posisi Dashboard', options = ['Top Left', 'Bottom Left', 'Top Right', 'Bottom Right'], group = grp_hud)
dashBgColor   = input.color(color.new(#1e222d, 10), 'Warna Background Dashboard', group = grp_hud)
dashTextColor = input.color(color.new(#f1f5f9, 0), 'Warna Teks Dashboard', group = grp_hud)

// --- GROUP 7: SINYAL KONFIRMASI (BUY & SELL ENTRY) ---
grp_sig = '7. SINYAL KONFIRMASI TRIPLE EMA & PATTERN'
showSignals          = input.bool(true, 'Tampilkan Sinyal Entry di Chart (Aktif Default)', group = grp_sig)
showBuySignal        = input.bool(true, 'Tampilkan Sinyal BUY (Panah Hijau)', group = grp_sig)
showSellSignal       = input.bool(true, 'Tampilkan Sinyal SELL (Panah Merah)', group = grp_sig)
signalMarkerStyle    = input.string('Tombol Panah di Candle (▲ BUY / ▼ SELL)', 'Model Tanda Sinyal di Candle', options = ['Tombol Panah di Candle (▲ BUY / ▼ SELL)', 'Panah Murni Tanpa Tulisan (Arrow Shape)', 'Simbol Panah Minimalis (▲ / ▼)', 'Kotak Detail SL/TP (Badge Panjang)'], group = grp_sig)
sigFrequency         = input.string('1 Sinyal Per Siklus Setup (Anti-Spam Pro)', 'Manajemen Sinyal Entry', options = ['1 Sinyal Per Siklus Setup (Anti-Spam Pro)', 'Cooldown Dinamis (Jeda 12 Lilin)', 'Bebas Semua Lilin (Multi-Signal)'], group = grp_sig)
sigMode              = input.string('Selesai Candle (Closed Bar - Non Repainting)', 'Waktu Muncul Sinyal', options = ['Selesai Candle (Closed Bar - Non Repainting)', 'Realtime Saat Candle Berjalan'], group = grp_sig)
signalStyle          = input.string('Ultra-Sniper Trend Pullback (Wajib Arah Tren + Koreksi EMA 8/21 + Lilin Konfirmasi)', 'Gaya / Tipe Sinyal Entry', options = ['Ultra-Sniper Trend Pullback (Wajib Arah Tren + Koreksi EMA 8/21 + Lilin Konfirmasi)', 'Semua Momentum (SMC Sniper + EMA Pullback + Breakout)', 'SMC Sniper Reversal Saja (Pucuk/Lembah)', 'EMA Pullback Saja (Trend Klasik)', 'Valid Breakout Saja (Momentum Tembusan)'], group = grp_sig)
sigConfluence        = input.string('Triple EMA + Candle Pattern (Pullback)', 'Mode Konfluensi Sinyal', options = ['Triple EMA + Candle Pattern (Pullback)', 'Triple EMA + SMC Confluence (Ketat)'], group = grp_sig)
showTpHitMarkers     = input.bool(true, 'Tampilkan Marker TP Hit 🎯 & SL Hit ❌', group = grp_sig)
showActiveTradeLines = input.bool(true, 'Tampilkan Garis Target SL/TP Trade Aktif', group = grp_sig)

// --- GROUP 8: FILTER KEAMANAN / WASPADAI SINYAL FALSE ---
grp_flt = '8. FILTER KEAMANAN (WASPADAI FALSE SIGNAL)'
filterChop          = input.bool(true, 'Filter EMA 8-21 Sideways / Bolak-Balik', group = grp_flt)
filter125Whip       = input.bool(true, 'Filter Whipsaw Lilin Bolak-Balik EMA 125', group = grp_flt)
filterStructure     = input.bool(true, 'Filter Struktur Market (Wajib HH-HL / LH-LL)', group = grp_flt)
filterOverextended  = input.bool(true, 'Filter Lilin Terlalu Jauh dari EMA (Overextended)', group = grp_flt)
maxAtrExtension     = input.float(2.2, 'Batas Overextension Lilin ke EMA (x ATR)', minval = 1.0, step = 0.1, group = grp_flt)
filterRsiExhaust    = input.bool(true, 'Filter RSI Exhaustion (Cegah SELL di Lembah / BUY di Pucuk)', group = grp_flt)
rsiPeriod           = input.int(14, 'Periode RSI Filter Exhaustion', minval = 2, group = grp_flt)

// --- GROUP 9: BREAKOUT, FAKEOUT & VOLUME (5 PILAR INSTITUSIONAL) ---
grp_bk = '9. BREAKOUT, FAKEOUT & VOLUME (5 PILAR ATURAN)'
showBreakoutLabels  = input.bool(false, 'Tampilkan Label Valid Breakout di Chart (Standalone)', group = grp_bk)
showFakeoutLabels   = input.bool(false, 'Tampilkan Label Fakeout (Wick Sweep Rejection)', group = grp_bk)
filterVolume        = input.bool(true, 'Filter Volume Wajib Meningkat Saat Breakout', group = grp_bk)
strictEmaHierarchy  = input.bool(true, 'Wajib Hierarki Ketat (EMA 8 > 21 > 125 untuk Buy)', group = grp_bk)


//+------------------------------------------------------------------+
//|    MODUL 0: TRIPLE EXPONENTIAL MOVING AVERAGE (EMA 8, 21, 125)   |
//+------------------------------------------------------------------+

float ema8   = ta.ema(close, lenEMA1)
float ema21  = ta.ema(close, lenEMA2)
float ema125 = ta.ema(close, lenEMA3)

pEma1 = plot(showEMA ? ema8 : na, title = 'EMA 8 (Fast)', color = colorEMA1, linewidth = 1)
pEma2 = plot(showEMA ? ema21 : na, title = 'EMA 21 (Medium)', color = colorEMA2, linewidth = 2)
plot(showEMA ? ema125 : na, title = 'EMA 125 (Trend Baseline)', color = colorEMA3, linewidth = 3)

color ribbonColor = (ema8 >= ema21) ? color.new(#00e5ff, 85) : color.new(#ff5252, 85)
fill(pEma1, pEma2, color = (showEMA and showEMARibbon) ? ribbonColor : na, title = 'EMA 8-21 Cloud Ribbon')

// Variabel Dasar Pasar (ATR, RSI & Volume)
float atr14          = ta.atr(14)
float rsi14          = ta.rsi(close, rsiPeriod)
float volMa20        = ta.sma(volume, 20)
bool  hasValidVolume = not na(volume) and (volume > 0)

// Geometri Lilin Dasar (Bar Properties)
float cRange    = high - low
float cBody     = math.abs(close - open)
float lowerWick = math.min(open, close) - low
float upperWick = high - math.max(open, close)
bool  isGreen   = close > open
bool  isRed     = close < open
bool  validSize = cRange >= (syminfo.mintick * 4)

// Analisis Volume Institusional
bool  isVolIncreasing = not hasValidVolume or (volume >= volMa20 * 1.05) or (volume >= nz(volume[1]) * 1.10)
bool  isVolDecreasing = not hasValidVolume or (volume < volMa20 * 0.90) or (volume < nz(volume[1]) * 0.95)

// Multi-Timeframe (MTF) Scalping Engine: Mengambil Tren H1/H4 Tertutup (100% Non-Repainting)
float htfEma8   = request.security(syminfo.tickerid, htfTimeframe, ta.ema(close, lenEMA1)[1], barmerge.gaps_off, barmerge.lookahead_off)
float htfEma21  = request.security(syminfo.tickerid, htfTimeframe, ta.ema(close, lenEMA2)[1], barmerge.gaps_off, barmerge.lookahead_off)
float htfEma125 = request.security(syminfo.tickerid, htfTimeframe, ta.ema(close, lenEMA3)[1], barmerge.gaps_off, barmerge.lookahead_off)
float htfClose  = request.security(syminfo.tickerid, htfTimeframe, close[1], barmerge.gaps_off, barmerge.lookahead_off)

// Evaluasi Bias Tren HTF (H1)
bool isHtfBull     = not na(htfClose) and (htfClose > htfEma125) and (htfEma8 > htfEma21)
bool isHtfBear     = not na(htfClose) and (htfClose < htfEma125) and (htfEma8 < htfEma21)
bool isHtfSideways = not isHtfBull and not isHtfBear

// Izin Sinyal Scalping M5/M15 (Wajib Selaras Trend HTF):
bool htfAllowsBuy  = not useHtfFilter or isHtfBull
bool htfAllowsSell = not useHtfFilter or isHtfBear



//+------------------------------------------------------------------+
//|    MODUL 1: SUPPORT & RESISTANCE REALTIME (SELALU MENGIKUTI)     |
//+------------------------------------------------------------------+

// 1. Level Ekstremum Dinamis Realtime (mengikuti ujung candle tertinggi/terendah tanpa lag!)
float hiDynamicMajor = ta.highest(high, srLengthMajor)
float loDynamicMajor = ta.lowest(low, srLengthMajor)

float hiDynamicMinor = ta.highest(high, srLengthMinor)
float loDynamicMinor = ta.lowest(low, srLengthMinor)

// 2. Pivot Swing Konfirmasi Cepat
pHiMajor = ta.pivothigh(high, srLengthMajor, 2)
pLoMajor = ta.pivotlow(low, srLengthMajor, 2)

pHiMinor = ta.pivothigh(high, srLengthMinor, 2)
pLoMinor = ta.pivotlow(low, srLengthMinor, 2)

var float majorResistance = na
var int   majorResBar     = na
var float majorSupport    = na
var int   majorSupBar     = na

var float minorResistance = na
var int   minorResBar     = na
var float minorSupport    = na
var int   minorSupBar     = na

// Update dinamis: Jika harga bergerak naik/turun melewati level lama, garis LANGSUNG mengikuti lilin terkini!
if not na(pHiMajor)
    majorResistance := pHiMajor
    majorResBar     := bar_index - 2
else if na(majorResistance) or (high > majorResistance)
    majorResistance := hiDynamicMajor
    majorResBar     := bar_index

if not na(pLoMajor)
    majorSupport := pLoMajor
    majorSupBar  := bar_index - 2
else if na(majorSupport) or (low < majorSupport)
    majorSupport := loDynamicMajor
    majorSupBar  := bar_index

if not na(pHiMinor)
    minorResistance := pHiMinor
    minorResBar     := bar_index - 2
else if na(minorResistance) or (high > minorResistance)
    minorResistance := hiDynamicMinor
    minorResBar     := bar_index

if not na(pLoMinor)
    minorSupport := pLoMinor
    minorSupBar  := bar_index - 2
else if na(minorSupport) or (low < minorSupport)
    minorSupport := loDynamicMinor
    minorSupBar  := bar_index

// Filter visibilitas Major / Minor
bool drawMajor = srFilterMode != 'Hanya S/R Terdekat (Minor Terdekat)'
bool drawMinor = srFilterMode != 'Hanya S/R Terkuat (Major)'

// Mode ekstensi garis
extendStyle = srExtendModel == 'Full Screen (Both)' ? extend.both : srExtendModel == 'Extend Right' ? extend.right : extend.none

// Proyeksikan garis horizontal penuh native TradingView ke sumbu harga (Track Price)
plot(showSR and srTrackPrice and drawMajor ? majorResistance : na, 'Major Resistance Live Track', color = colorResistance, linewidth = lineWidthSR, style = plot.style_linebr, trackprice = true)
plot(showSR and srTrackPrice and drawMajor ? majorSupport : na, 'Major Support Live Track', color = colorSupport, linewidth = lineWidthSR, style = plot.style_linebr, trackprice = true)
plot(showSR and srTrackPrice and drawMinor ? minorResistance : na, 'Minor Resistance Live Track', color = color.new(colorResistance, 35), linewidth = 1, style = plot.style_linebr, trackprice = true)
plot(showSR and srTrackPrice and drawMinor ? minorSupport : na, 'Minor Support Live Track', color = color.new(colorSupport, 35), linewidth = 1, style = plot.style_linebr, trackprice = true)

// Variabel garis & label visual di chart
var line lineResMajor = na
var line lineSupMajor = na
var line lineResMinor = na
var line lineSupMinor = na

var label lblResMajor = na
var label lblSupMajor = na
var label lblResMinor = na
var label lblSupMinor = na

if barstate.islast and showSR
    line.delete(lineResMajor)
    line.delete(lineSupMajor)
    line.delete(lineResMinor)
    line.delete(lineSupMinor)
    label.delete(lblResMajor)
    label.delete(lblSupMajor)
    label.delete(lblResMinor)
    label.delete(lblSupMinor)

    float atrVal = ta.atr(14)
    bool closeRes = not na(majorResistance) and not na(minorResistance) and (math.abs(majorResistance - minorResistance) < (atrVal * 1.0))
    bool closeSup = not na(majorSupport) and not na(minorSupport) and (math.abs(majorSupport - minorSupport) < (atrVal * 1.0))

    int xMajor    = bar_index + srLabelOffset
    int xMinorRes = closeRes ? (bar_index + srLabelOffset + 14) : (bar_index + srLabelOffset)
    int xMinorSup = closeSup ? (bar_index + srLabelOffset + 14) : (bar_index + srLabelOffset)

    // 1. Major Resistance Terkuat
    if drawMajor and not na(majorResistance)
        int startRes = not na(majorResBar) ? majorResBar : (bar_index - srLengthMajor)
        lineResMajor := line.new(startRes, majorResistance, bar_index + srLabelOffset, majorResistance, color = colorResistance, width = lineWidthSR, style = line.style_solid, extend = extendStyle)
        if showSRLabels
            lblResMajor := label.new(xMajor, majorResistance, 'R Major: ' + str.tostring(majorResistance, '#.##'), color = color.new(colorResistance, 20), textcolor = color.white, style = label.style_label_left, size = size.small)

    // 2. Major Support Terkuat
    if drawMajor and not na(majorSupport)
        int startSup = not na(majorSupBar) ? majorSupBar : (bar_index - srLengthMajor)
        lineSupMajor := line.new(startSup, majorSupport, bar_index + srLabelOffset, majorSupport, color = colorSupport, width = lineWidthSR, style = line.style_solid, extend = extendStyle)
        if showSRLabels
            lblSupMajor := label.new(xMajor, majorSupport, 'S Major: ' + str.tostring(majorSupport, '#.##'), color = color.new(colorSupport, 20), textcolor = color.white, style = label.style_label_left, size = size.small)

    // 3. Minor Resistance Terdekat
    if drawMinor and not na(minorResistance) and minorResistance != majorResistance
        int startMinRes = not na(minorResBar) ? minorResBar : (bar_index - srLengthMinor)
        lineResMinor := line.new(startMinRes, minorResistance, bar_index + srLabelOffset, minorResistance, color = color.new(colorResistance, 40), width = 1, style = line.style_dashed, extend = extendStyle)
        if showSRLabels
            lblResMinor := label.new(xMinorRes, minorResistance, 'R Minor (Terdekat): ' + str.tostring(minorResistance, '#.##'), color = color.new(colorResistance, 50), textcolor = color.white, style = label.style_label_left, size = size.tiny)

    // 4. Minor Support Terdekat
    if drawMinor and not na(minorSupport) and minorSupport != majorSupport
        int startMinSup = not na(minorSupBar) ? minorSupBar : (bar_index - srLengthMinor)
        lineSupMinor := line.new(startMinSup, minorSupport, bar_index + srLabelOffset, minorSupport, color = color.new(colorSupport, 40), width = 1, style = line.style_dashed, extend = extendStyle)
        if showSRLabels
            lblSupMinor := label.new(xMinorSup, minorSupport, 'S Minor (Terdekat): ' + str.tostring(minorSupport, '#.##'), color = color.new(colorSupport, 50), textcolor = color.white, style = label.style_label_left, size = size.tiny)


//+------------------------------------------------------------------+
//|            MODUL 2: STRUKTUR PASAR (BOS & CHOCH)                 |
//+------------------------------------------------------------------+

pHiStruct = ta.pivothigh(high, structLookback, structLookback)
pLoStruct = ta.pivotlow(low, structLookback, structLookback)

var float lastSwingHigh    = na
var float prevSwingHigh    = na
var int   lastSwingHighBar = na
var float lastSwingLow     = na
var float prevSwingLow     = na
var int   lastSwingLowBar  = na

var int    marketTrend     = 0 // 1 = Bullish, -1 = Bearish
var string lastStructName  = 'None'
var string lastSwingStatus = 'None' // HH, HL, LH, LL

var label[] swingLabels = array.new_label()

if not na(pHiStruct)
    prevSwingHigh := lastSwingHigh
    lastSwingHigh := pHiStruct
    lastSwingHighBar := bar_index - structLookback
    string shType = (not na(prevSwingHigh) and lastSwingHigh > prevSwingHigh) ? 'HH' : 'LH'
    lastSwingStatus := shType
    if showSwingLabels and showStructure
        label shLbl = label.new(lastSwingHighBar, lastSwingHigh, shType, color = color.new(color.black, 100), textcolor = color.new(#94a3b8, 20), style = label.style_label_down, size = size.tiny)
        array.push(swingLabels, shLbl)
        if array.size(swingLabels) > 30
            label.delete(array.shift(swingLabels))

if not na(pLoStruct)
    prevSwingLow := lastSwingLow
    lastSwingLow := pLoStruct
    lastSwingLowBar := bar_index - structLookback
    string slType = (not na(prevSwingLow) and lastSwingLow > prevSwingLow) ? 'HL' : 'LL'
    lastSwingStatus := slType
    if showSwingLabels and showStructure
        label slLbl = label.new(lastSwingLowBar, lastSwingLow, slType, color = color.new(color.black, 100), textcolor = color.new(#94a3b8, 20), style = label.style_label_up, size = size.tiny)
        array.push(swingLabels, slLbl)
        if array.size(swingLabels) > 30
            label.delete(array.shift(swingLabels))

bool bullBreak = not na(lastSwingHigh) and ta.crossover(close, lastSwingHigh)
bool bearBreak = not na(lastSwingLow) and ta.crossunder(close, lastSwingLow)

var line[]  structLines  = array.new_line()
var label[] structLabels = array.new_label()

if showStructure
    if bullBreak
        bool isBOS = (marketTrend == 1)
        string structTag = isBOS ? 'BOS' : 'CHoCH'
        lastStructName := isBOS ? 'BULLISH BOS' : 'BULLISH CHoCH'
        if not isBOS
            marketTrend := 1

        // Tarik garis horizontal dari candle swing sebelumnya (lastSwingHighBar) sampai candle tembusan saat ini (bar_index)
        int xStartBull = not na(lastSwingHighBar) ? lastSwingHighBar : (bar_index - structLookback)
        line bLine = line.new(xStartBull, lastSwingHigh, bar_index, lastSwingHigh, color = colorBullStruct, width = 1, style = isBOS ? line.style_solid : line.style_dashed)
        array.push(structLines, bLine)
        if array.size(structLines) > 50
            line.delete(array.shift(structLines))

        // Tulisan BOS / CHoCH jelas di tengah garis dengan pill badge modern (LuxAlgo Pro SMC style)
        int midBullBar = math.round((xStartBull + bar_index) / 2)
        label bLbl = label.new(midBullBar, lastSwingHigh, structTag, color = color.new(#0f172a, 10), textcolor = colorBullStruct, style = label.style_label_center, size = size.small)
        array.push(structLabels, bLbl)
        if array.size(structLabels) > 50
            label.delete(array.shift(structLabels))

    if bearBreak
        bool isBOS = (marketTrend == -1)
        string structTag = isBOS ? 'BOS' : 'CHoCH'
        lastStructName := isBOS ? 'BEARISH BOS' : 'BEARISH CHoCH'
        if not isBOS
            marketTrend := -1

        // Tarik garis horizontal dari candle swing sebelumnya (lastSwingLowBar) sampai candle tembusan saat ini (bar_index)
        int xStartBear = not na(lastSwingLowBar) ? lastSwingLowBar : (bar_index - structLookback)
        line sLine = line.new(xStartBear, lastSwingLow, bar_index, lastSwingLow, color = colorBearStruct, width = 1, style = isBOS ? line.style_solid : line.style_dashed)
        array.push(structLines, sLine)
        if array.size(structLines) > 50
            line.delete(array.shift(structLines))

        // Tulisan BOS / CHoCH jelas di tengah garis dengan pill badge modern (LuxAlgo Pro SMC style)
        int midBearBar = math.round((xStartBear + bar_index) / 2)
        label sLbl = label.new(midBearBar, lastSwingLow, structTag, color = color.new(#0f172a, 10), textcolor = colorBearStruct, style = label.style_label_center, size = size.small)
        array.push(structLabels, sLbl)
        if array.size(structLabels) > 50
            label.delete(array.shift(structLabels))


//+------------------------------------------------------------------+
//|    MODUL 2B: LIQUIDITAS INSTITUSIONAL (IDM & SSS SWEEP)          |
//+------------------------------------------------------------------+

// 1. Inducement (IDM) Tracking
// IDM adalah swing pullback internal minor pertama setelah terbentuknya swing ekstrem
pHiIDM = ta.pivothigh(high, idmPullbackLen, 1)
pLoIDM = ta.pivotlow(low, idmPullbackLen, 1)

var float activeBullIDM       = na
var int   activeBullIDMBar    = na
var bool  isBullIDMSwept      = false
var int   lastBullIDMSweepBar = na

var float activeBearIDM       = na
var int   activeBearIDMBar    = na
var bool  isBearIDMSwept      = false
var int   lastBearIDMSweepBar = na

// Reset & Deteksi Bullish IDM (Dalam Tren Bullish)
if marketTrend == 1
    // Reset IDM jika terjadi BOS baru atau tembusan Swing High
    if bullBreak or (not na(lastSwingHigh) and ta.crossover(close, lastSwingHigh))
        activeBullIDM    := na
        activeBullIDMBar := na
        isBullIDMSwept   := false

    // Ambil titik pullback minor pertama setelah Swing High terbentuk
    if na(activeBullIDM) and not na(pLoIDM) and (not na(lastSwingHighBar) and (bar_index - 1) > lastSwingHighBar)
        activeBullIDM    := pLoIDM
        activeBullIDMBar := bar_index - 1
        isBullIDMSwept   := false

    // Deteksi saat Inducement disapu (Swept) oleh candle
    if not na(activeBullIDM) and not isBullIDMSwept and (low < activeBullIDM)
        isBullIDMSwept      := true
        lastBullIDMSweepBar := bar_index

// Reset & Deteksi Bearish IDM (Dalam Tren Bearish)
if marketTrend == -1
    // Reset IDM jika terjadi BOS baru atau tembusan Swing Low
    if bearBreak or (not na(lastSwingLow) and ta.crossunder(close, lastSwingLow))
        activeBearIDM    := na
        activeBearIDMBar := na
        isBearIDMSwept   := false

    // Ambil titik pullback minor pertama setelah Swing Low terbentuk
    if na(activeBearIDM) and not na(pHiIDM) and (not na(lastSwingLowBar) and (bar_index - 1) > lastSwingLowBar)
        activeBearIDM    := pHiIDM
        activeBearIDMBar := bar_index - 1
        isBearIDMSwept   := false

    // Deteksi saat Inducement disapu (Swept) oleh candle
    if not na(activeBearIDM) and not isBearIDMSwept and (high > activeBearIDM)
        isBearIDMSwept      := true
        lastBearIDMSweepBar := bar_index

bool justBullIDMSwept = not na(activeBullIDM) and isBullIDMSwept and (low < activeBullIDM) and (nz(low[1], 0.0) >= activeBullIDM)
bool justBearIDMSwept = not na(activeBearIDM) and isBearIDMSwept and (high > activeBearIDM) and (nz(high[1], 0.0) <= activeBearIDM)

// 2. Stop Sweep Setup (SSS - BSL & SSL Liquidity Sweep)
// BSL Sweep: Lilin menembus swing high / resistance dengan ekor atas panjang, namun tutup di bawah level
bool isBSLSweep = (not na(lastSwingHigh) and high > lastSwingHigh and close <= lastSwingHigh and upperWick >= cRange * 0.35) or (not na(majorResistance[1]) and high > majorResistance[1] and close <= majorResistance[1] and upperWick >= cRange * 0.35)

// SSL Sweep: Lilin menembus swing low / support dengan ekor bawah panjang, namun tutup di atas level
bool isSSLSweep = (not na(lastSwingLow) and low < lastSwingLow and close >= lastSwingLow and lowerWick >= cRange * 0.35) or (not na(majorSupport[1]) and low < majorSupport[1] and close >= majorSupport[1] and lowerWick >= cRange * 0.35)

// Visual SSS di Chart
if showLiquidity and showSSSSweep
    if isBSLSweep
        label.new(bar_index, high + (atr14 * 0.30), 'SSS 🎯 BSL', color = color.new(#7f1d1d, 10), textcolor = #fecaca, style = label.style_label_down, size = size.tiny)
    if isSSLSweep
        label.new(bar_index, low - (atr14 * 0.30), 'SSS 🎯 SSL', color = color.new(#064e3b, 10), textcolor = #a7f3d0, style = label.style_label_up, size = size.tiny)

// Visual IDM Swept di Lilin Terjadinya Sweep
if showLiquidity and showIDMLine
    if justBullIDMSwept
        label.new(bar_index, low - (atr14 * 0.20), 'IDM ⚡', color = color.new(#d97706, 10), textcolor = #fef3c7, style = label.style_label_up, size = size.tiny)
    if justBearIDMSwept
        label.new(bar_index, high + (atr14 * 0.20), 'IDM ⚡', color = color.new(#d97706, 10), textcolor = #fef3c7, style = label.style_label_down, size = size.tiny)

// Visual Garis IDM Terkini yang Belum / Sedang Diuji
var line  lineIDM = na
var label lblIDM  = na

if barstate.islast and showLiquidity and showIDMLine
    line.delete(lineIDM)
    label.delete(lblIDM)

    float activeIDMVal  = (marketTrend == 1) ? activeBullIDM : (marketTrend == -1) ? activeBearIDM : na
    int   activeIDMBar  = (marketTrend == 1) ? activeBullIDMBar : (marketTrend == -1) ? activeBearIDMBar : na
    bool  isSweptStatus = (marketTrend == 1) ? isBullIDMSwept : (marketTrend == -1) ? isBearIDMSwept : false

    if not na(activeIDMVal) and not na(activeIDMBar)
        color idmLineClr = isSweptStatus ? color.new(color.gray, 60) : colorIDM
        lineIDM := line.new(activeIDMBar, activeIDMVal, bar_index + srLabelOffset, activeIDMVal, color = idmLineClr, width = 1, style = line.style_dashed, extend = extendStyle)
        string idmText = 'IDM: ' + str.tostring(activeIDMVal, '#.##') + (isSweptStatus ? ' [Swept ⚡]' : ' [Target 🎯]')
        lblIDM  := label.new(bar_index + srLabelOffset, activeIDMVal, idmText, color = color.new(idmLineClr, 20), textcolor = color.white, style = label.style_label_left, size = size.tiny)


//+------------------------------------------------------------------+
//|    MODUL 3: AUTO FIBONACCI GOLDEN ZONE (ADAPTIF CHOCH & M5 WAVE) |
//+------------------------------------------------------------------+

// Ayunan dealing range aktif (Rolling Peak & Trough M5 yang dipadukan dengan Swing Structural)
float rollHigh = ta.highest(high, fiboLength)
float rollLow  = ta.lowest(low, fiboLength)
int   barHigh  = bar_index + ta.highestbars(high, fiboLength)
int   barLow   = bar_index + ta.lowestbars(low, fiboLength)

// Ambil titik ekstrem tertinggi & terendah yang relevan dengan struktur aktif
float fiboHighVal = not na(lastSwingHigh) and (bar_index - lastSwingHighBar <= fiboLength * 2) ? math.max(rollHigh, lastSwingHigh) : rollHigh
float fiboLowVal  = not na(lastSwingLow)  and (bar_index - lastSwingLowBar  <= fiboLength * 2) ? math.min(rollLow, lastSwingLow)   : rollLow
int   fiboHighBar = (fiboHighVal == rollHigh) ? barHigh : lastSwingHighBar
int   fiboLowBar  = (fiboLowVal  == rollLow)  ? barLow  : lastSwingLowBar
float fiboDiff    = math.abs(fiboHighVal - fiboLowVal)

// Arah Ayunan Murni M5 (High vs Low yang lebih baru)
bool isSwingBullish = (fiboHighBar >= fiboLowBar)

// Evaluasi Arah Fibonacci Realtime (SELL Zone vs BUY Zone)
bool isFiboForSell = false
bool isFiboForBuy  = false

if fiboDirectionMode == 'Khusus SELL Zone (Koreksi Naik / Rebound)'
    isFiboForSell := true
else if fiboDirectionMode == 'Khusus BUY Zone (Koreksi Turun / Dip)'
    isFiboForBuy := true
else if fiboDirectionMode == 'Otomatis Selaras HTF Bias (H1/H4)'
    if isHtfBear
        isFiboForSell := true
    else if isHtfBull
        isFiboForBuy := true
    else
        isFiboForBuy  := isSwingBullish
        isFiboForSell := not isSwingBullish
else
    // Default: 'Otomatis Adaptif (CHoCH & Gelombang M5)'
    // Prioritas 1: Respon adaptif terhadap struktur pasar aktif di M5
    if marketTrend == 1 or lastStructName == 'BULLISH CHoCH' or lastStructName == 'BULLISH BOS'
        isFiboForBuy := true
    else if marketTrend == -1 or lastStructName == 'BEARISH CHoCH' or lastStructName == 'BEARISH BOS'
        isFiboForSell := true
    // Prioritas 2: Selaras dengan HTF jika struktur M5 netral
    else if isHtfBull
        isFiboForBuy := true
    else if isHtfBear
        isFiboForSell := true
    // Prioritas 3: Ayunan gelombang lilin M5 aktif
    else
        isFiboForBuy  := isSwingBullish
        isFiboForSell := not isSwingBullish

// Level Retracement Presisi Sesuai Arah:
// BUY: Mengukur koreksi turun dari High menuju Low -> Golden Pocket di 50% - 65% penurunan dari High
// SELL: Mengukur koreksi naik dari Low menuju High -> Golden Pocket di 50% - 65% kenaikan dari Low
float fiboP50  = isFiboForBuy ? fiboHighVal - (fiboDiff * 0.50) : fiboLowVal + (fiboDiff * 0.50)
float fiboP65  = isFiboForBuy ? fiboHighVal - (fiboDiff * 0.65) : fiboLowVal + (fiboDiff * 0.65)
float fiboP618 = isFiboForBuy ? fiboHighVal - (fiboDiff * 0.618) : fiboLowVal + (fiboDiff * 0.618)

float topGold = math.max(fiboP50, fiboP65)
float btmGold = math.min(fiboP50, fiboP65)

// Deteksi Invalidation (Zona Fibo Ditembus / Jebol):
// Jika SELL tapi harga naik tembus di atas batas atas Golden Pocket
// Jika BUY tapi harga anjlok tembus di bawah batas bawah Golden Pocket
bool isFiboBroken = (fiboDiff > 0) and (isFiboForSell ? (close > topGold + (fiboDiff * 0.05)) : (close < btmGold - (fiboDiff * 0.05)))
bool inGoldenZone = (fiboDiff > 0) and not isFiboBroken and (close <= topGold) and (close >= btmGold)

plot(showFibo and srTrackPrice ? fiboP618 : na, 'Fibo 61.8% Live Track', color = isFiboForSell ? color.new(#fb7185, 20) : color.new(#34d399, 20), linewidth = 2, style = plot.style_linebr, trackprice = true)

var box   boxGoldenZone = na
var line  lineFibo618   = na
var label lblFiboGold   = na

// Style extend: jika Fibo jebol, jangan extend ke kanan agar tidak menutupi chart masa depan
extendFiboStyle = (isFiboBroken) ? extend.none : (fiboExtendModel == 'Extend Right' ? extend.right : extend.none)

if barstate.islast and showFibo and fiboDiff > 0
    box.delete(boxGoldenZone)
    line.delete(lineFibo618)
    label.delete(lblFiboGold)

    int startBar = math.min(nz(fiboHighBar), nz(fiboLowBar))

    color baseBoxColor   = isFiboForSell ? #e11d48 : #059669
    color curBoxColor    = isFiboBroken ? color.new(color.gray, 92) : color.new(baseBoxColor, 90)
    color curBorderColor = isFiboBroken ? color.new(color.gray, 70) : color.new(baseBoxColor, 40)
    color curLineColor   = isFiboBroken ? color.new(color.gray, 50) : (isFiboForSell ? color.new(#fb7185, 20) : color.new(#34d399, 20))
    color curLabelBg     = isFiboBroken ? color.new(color.gray, 30) : (isFiboForSell ? color.new(#be123c, 20) : color.new(#047857, 20))
    
    string statusSuffix  = isFiboBroken ? ' [JEBOL / INVALIDE ⚠️]' : ''
    string zoneTitle     = isFiboForSell ? ('Fibo OTE SELL Zone (50 - 65%) 🔴' + statusSuffix) : ('Fibo OTE BUY Zone (50 - 65%) 🟢' + statusSuffix)
    string goldText      = isFiboForSell ? ('Golden Pocket 61.8% (SELL OTE): ' + str.tostring(fiboP618, '#.##') + statusSuffix) : ('Golden Pocket 61.8% (BUY OTE): ' + str.tostring(fiboP618, '#.##') + statusSuffix)

    boxGoldenZone := box.new(startBar, topGold, bar_index + srLabelOffset, btmGold, bgcolor = curBoxColor, border_color = curBorderColor, border_width = 1, extend = extendFiboStyle)
    if showFiboLabels
        box.set_text(boxGoldenZone, zoneTitle)
        box.set_text_size(boxGoldenZone, size.tiny)
        box.set_text_color(boxGoldenZone, isFiboBroken ? color.silver : (isFiboForSell ? #fecdd3 : #a7f3d0))
        box.set_text_valign(boxGoldenZone, text.align_top)
        box.set_text_halign(boxGoldenZone, text.align_center)

    lineFibo618 := line.new(startBar, fiboP618, bar_index + srLabelOffset, fiboP618, color = curLineColor, width = 2, style = line.style_dashed, extend = extendFiboStyle)

    if showFiboLabels
        lblFiboGold := label.new(bar_index + srLabelOffset, fiboP618, goldText, color = curLabelBg, textcolor = color.white, style = label.style_label_left, size = size.tiny)


//+------------------------------------------------------------------+
//|            MODUL 4: INSTITUTIONAL ORDER BLOCK (OB)               |
//+------------------------------------------------------------------+

type OrderBlock
    box   boxId
    float top
    float bottom
    bool  isBullish
    bool  isMitigated

var orderBlocks = array.new<OrderBlock>()

// Deteksi Bullish OB (Demand Valid A+)
// 1. Lilin [1] merah, Lilin [0] hijau kuat menelan high[1] dengan body besar
bool isBullBase = (close > open) and (close[1] < open[1]) and (close > high[1]) and ((close - open) > (atr14 * 0.85))

// 2. Kriteria Validitas A+ Institusional:
// a. Liquidity Sweep: Lilin [1] menyapu low lilin sebelumnya [2]
bool isBullSweep = low[1] <= low[2]
// b. Menghasilkan Imbalance (FVG): Ada celah antara low saat ini dan high[2]
bool isBullCreatesFVG = low > high[2]
// c. Struktur / Momentum Searah: Di atas EMA 125, atau EMA 8 > 21, atau menembus Swing High (BOS)
bool isBullStructAlign = (close > ema125) or (ema8 > ema21) or (not na(lastSwingHigh) and close > lastSwingHigh)

// Syarat Valid OB Bullish:
bool isBullishDisplacement = obStrictFilter ? (isBullBase and (isBullCreatesFVG or isBullSweep) and isBullStructAlign) : isBullBase

if showOB and isBullishDisplacement
    float obTop = math.max(open[1], close[1])
    float obBtm = low[1]
    box b = box.new(bar_index - 1, obTop, bar_index, obBtm, bgcolor = colorBullOB, border_color = borderBullOB, border_width = 1, extend = extend.right, text = showOBLabels ? 'Bullish OB (Valid Demand)' : '', text_size = size.tiny, text_color = color.white, text_valign = text.align_center, text_halign = text.align_center)
    array.push(orderBlocks, OrderBlock.new(b, obTop, obBtm, true, false))

// Deteksi Bearish OB (Supply Valid A+)
// 1. Lilin [1] hijau, Lilin [0] merah kuat menelan low[1] dengan body besar
bool isBearBase = (close < open) and (close[1] > open[1]) and (close < low[1]) and ((open - close) > (atr14 * 0.85))

// 2. Kriteria Validitas A+ Institusional:
// a. Liquidity Sweep: Lilin [1] menyapu high lilin sebelumnya [2]
bool isBearSweep = high[1] >= high[2]
// b. Menghasilkan Imbalance (FVG): Ada celah antara high saat ini dan low[2]
bool isBearCreatesFVG = high < low[2]
// c. Struktur / Momentum Searah: Di bawah EMA 125, atau EMA 8 < 21, atau menembus Swing Low (BOS)
bool isBearStructAlign = (close < ema125) or (ema8 < ema21) or (not na(lastSwingLow) and close < lastSwingLow)

// Syarat Valid OB Bearish:
bool isBearishDisplacement = obStrictFilter ? (isBearBase and (isBearCreatesFVG or isBearSweep) and isBearStructAlign) : isBearBase

if showOB and isBearishDisplacement
    float obTop = high[1]
    float obBtm = math.min(open[1], close[1])
    box b = box.new(bar_index - 1, obTop, bar_index, obBtm, bgcolor = colorBearOB, border_color = borderBearOB, border_width = 1, extend = extend.right, text = showOBLabels ? 'Bearish OB (Valid Supply)' : '', text_size = size.tiny, text_color = color.white, text_valign = text.align_center, text_halign = text.align_center)
    array.push(orderBlocks, OrderBlock.new(b, obTop, obBtm, false, false))

// Manajemen Array OB & Pelacakan Mitigasi Presisi
bool touchDemandOB = false
bool touchSupplyOB = false

int unmitigatedOBCount = 0
int bestBullIdx = -1
float minBullDist = 1e10
int bestBearIdx = -1
float minBearDist = 1e10

int latestBullIdx = -1
int latestBearIdx = -1

if array.size(orderBlocks) > 0
    for i = 0 to array.size(orderBlocks) - 1
        OrderBlock currentOB = array.get(orderBlocks, i)
        if not currentOB.isMitigated
            // Periksa sentuhan untuk sinyal konfluensi SEBELUM kotak dimitigasi/dihapus!
            if currentOB.isBullish and (low <= currentOB.top) and (high >= currentOB.bottom)
                touchDemandOB := true
            if not currentOB.isBullish and (high >= currentOB.bottom) and (low <= currentOB.top)
                touchSupplyOB := true

            // Cek Mitigasi Bullish OB (Demand Valid A+)
            // Zona tetap aktif saat retest, hanya termitigasi jika ditembus tembus (low <= bottom atau close < Mean Threshold 50%)
            float bullMeanThreshold = (currentOB.top + currentOB.bottom) / 2
            if currentOB.isBullish and (low <= currentOB.bottom or close < bullMeanThreshold)
                currentOB.isMitigated := true
                box.set_extend(currentOB.boxId, extend.none)
                box.set_right(currentOB.boxId, bar_index)
                box.set_text(currentOB.boxId, '')
                if hideMitigatedOB
                    box.delete(currentOB.boxId)
                else
                    box.set_bgcolor(currentOB.boxId, color.new(color.gray, 90))
                    box.set_border_style(currentOB.boxId, line.style_dotted)

            // Cek Mitigasi Bearish OB (Supply Valid A+)
            // Zona tetap aktif saat retest, hanya termitigasi jika ditembus ke atas (high >= top atau close > Mean Threshold 50%)
            float bearMeanThreshold = (currentOB.top + currentOB.bottom) / 2
            if not currentOB.isMitigated and not currentOB.isBullish and (high >= currentOB.top or close > bearMeanThreshold)
                currentOB.isMitigated := true
                box.set_extend(currentOB.boxId, extend.none)
                box.set_right(currentOB.boxId, bar_index)
                box.set_text(currentOB.boxId, '')
                if hideMitigatedOB
                    box.delete(currentOB.boxId)
                else
                    box.set_bgcolor(currentOB.boxId, color.new(color.gray, 90))
                    box.set_border_style(currentOB.boxId, line.style_dotted)

        if not currentOB.isMitigated
            unmitigatedOBCount += 1
            // Lacak zona terdekat dengan harga saat ini (close)
            if currentOB.isBullish
                latestBullIdx := i
                float dist = close >= currentOB.top ? (close - currentOB.top) : (currentOB.top - close + 1000)
                if dist < minBullDist
                    minBullDist := dist
                    bestBullIdx := i
            else
                latestBearIdx := i
                float dist = currentOB.bottom >= close ? (currentOB.bottom - close) : (close - currentOB.bottom + 1000)
                if dist < minBearDist
                    minBearDist := dist
                    bestBearIdx := i

    // Filter visibilitas berdasarkan pilihan user
    int targetBull = obDisplayMode == '1 Terbaru (Lilin Paling Baru)' ? latestBullIdx : bestBullIdx
    int targetBear = obDisplayMode == '1 Terbaru (Lilin Paling Baru)' ? latestBearIdx : bestBearIdx

    if obDisplayMode != 'Semua Zona Aktif'
        for i = 0 to array.size(orderBlocks) - 1
            OrderBlock ob = array.get(orderBlocks, i)
            if not ob.isMitigated
                if i == targetBull or i == targetBear
                    box.set_bgcolor(ob.boxId, ob.isBullish ? colorBullOB : colorBearOB)
                    box.set_border_color(ob.boxId, ob.isBullish ? borderBullOB : borderBearOB)
                    box.set_extend(ob.boxId, extend.right)
                    if showOBLabels
                        box.set_text(ob.boxId, ob.isBullish ? 'Bullish OB (Valid Demand)' : 'Bearish OB (Valid Supply)')
                        box.set_text_size(ob.boxId, size.tiny)
                        box.set_text_color(ob.boxId, color.white)
                        box.set_text_valign(ob.boxId, text.align_center)
                        box.set_text_halign(ob.boxId, text.align_center)
                else
                    box.set_bgcolor(ob.boxId, color.new(color.black, 100))
                    box.set_border_color(ob.boxId, color.new(color.black, 100))
                    box.set_extend(ob.boxId, extend.none)
                    box.set_right(ob.boxId, bar_index)
                    box.set_text(ob.boxId, '')

while array.size(orderBlocks) > 15
    OrderBlock oldOB = array.shift(orderBlocks)
    box.delete(oldOB.boxId)


//+------------------------------------------------------------------+
//|            MODUL 5: FAIR VALUE GAP (FVG / IMBALANCE)             |
//+------------------------------------------------------------------+

type FVG
    box   boxId
    float top
    float bottom
    bool  isBullish
    bool  isMitigated

var fvgList = array.new<FVG>()
float minFvgDistance  = fvgMinTicks * syminfo.mintick
float effectiveMinFvg = math.max(minFvgDistance, atr14 * fvgMinAtrPercent)

// 1. Bullish FVG Valid
bool isBullGap = (low > high[2]) and ((low - high[2]) >= effectiveMinFvg)
// Lilin tengah (candle [1]) harus lilin hijau impulsif yang kuat (bukan lilin ragu-ragu / doji)
bool isMiddleBullImpulse = (close[1] > open[1]) and (math.abs(close[1] - open[1]) >= (high[1] - low[1]) * 0.50) and ((high[1] - low[1]) >= atr14 * 0.50)
bool isBullFvgTrendAligned = (close[1] > ema125) or (ema8 > ema21) or (close > ema125)

bool isBullFVG = fvgStrictFilter ? (isBullGap and isMiddleBullImpulse and isBullFvgTrendAligned) : isBullGap

if showFVG and isBullFVG
    float topFvg = low
    float btmFvg = high[2]
    box b = box.new(bar_index - 1, topFvg, bar_index, btmFvg, bgcolor = colorBullFVG, border_color = color.new(#10b981, 40), border_width = 1, extend = extend.right, text = showFVGLabels ? 'Bullish FVG (Valid Imbalance)' : '', text_size = size.tiny, text_color = color.white, text_valign = text.align_center, text_halign = text.align_center)
    array.push(fvgList, FVG.new(b, topFvg, btmFvg, true, false))

// 2. Bearish FVG Valid
bool isBearGap = (high < low[2]) and ((low[2] - high) >= effectiveMinFvg)
// Lilin tengah (candle [1]) harus lilin merah impulsif yang kuat
bool isMiddleBearImpulse = (close[1] < open[1]) and (math.abs(open[1] - close[1]) >= (high[1] - low[1]) * 0.50) and ((high[1] - low[1]) >= atr14 * 0.50)
bool isBearFvgTrendAligned = (close[1] < ema125) or (ema8 < ema21) or (close < ema125)

bool isBearFVG = fvgStrictFilter ? (isBearGap and isMiddleBearImpulse and isBearFvgTrendAligned) : isBearGap

if showFVG and isBearFVG
    float topFvg = low[2]
    float btmFvg = high
    box b = box.new(bar_index - 1, topFvg, bar_index, btmFvg, bgcolor = colorBearFVG, border_color = color.new(#ef4444, 40), border_width = 1, extend = extend.right, text = showFVGLabels ? 'Bearish FVG (Valid Imbalance)' : '', text_size = size.tiny, text_color = color.white, text_valign = text.align_center, text_halign = text.align_center)
    array.push(fvgList, FVG.new(b, topFvg, btmFvg, false, false))

// Pelacakan Penutupan FVG Presisi
bool touchBullFVG = false
bool touchBearFVG = false

int unmitigatedFVGCount = 0
int bestBullFvgIdx = -1
float minBullFvgDist = 1e10
int bestBearFvgIdx = -1
float minBearFvgDist = 1e10

int latestBullFvgIdx = -1
int latestBearFvgIdx = -1

if array.size(fvgList) > 0
    for i = 0 to array.size(fvgList) - 1
        FVG currentFVG = array.get(fvgList, i)
        if not currentFVG.isMitigated
            // Periksa sentuhan sebelum tertutup/dimitigasi
            if currentFVG.isBullish and (low <= currentFVG.top) and (high >= currentFVG.bottom)
                touchBullFVG := true
            if not currentFVG.isBullish and (high >= currentFVG.bottom) and (low <= currentFVG.top)
                touchBearFVG := true

            if currentFVG.isBullish and low <= currentFVG.bottom
                currentFVG.isMitigated := true
                box.set_extend(currentFVG.boxId, extend.none)
                box.set_right(currentFVG.boxId, bar_index)
                box.set_text(currentFVG.boxId, '')
                if hideMitigatedFVG
                    box.delete(currentFVG.boxId)
                else
                    box.set_bgcolor(currentFVG.boxId, color.new(color.gray, 92))

            if not currentFVG.isMitigated and not currentFVG.isBullish and high >= currentFVG.top
                currentFVG.isMitigated := true
                box.set_extend(currentFVG.boxId, extend.none)
                box.set_right(currentFVG.boxId, bar_index)
                box.set_text(currentFVG.boxId, '')
                if hideMitigatedFVG
                    box.delete(currentFVG.boxId)
                else
                    box.set_bgcolor(currentFVG.boxId, color.new(color.gray, 92))

        if not currentFVG.isMitigated
            unmitigatedFVGCount += 1
            if currentFVG.isBullish
                latestBullFvgIdx := i
                float dist = close >= currentFVG.top ? (close - currentFVG.top) : (currentFVG.top - close + 1000)
                if dist < minBullFvgDist
                    minBullFvgDist := dist
                    bestBullFvgIdx := i
            else
                latestBearFvgIdx := i
                float dist = currentFVG.bottom >= close ? (currentFVG.bottom - close) : (close - currentFVG.bottom + 1000)
                if dist < minBearFvgDist
                    minBearFvgDist := dist
                    bestBearFvgIdx := i

    // Filter visibilitas FVG berdasarkan pilihan user
    int targetBullFvg = fvgDisplayMode == '1 Terbaru (Paling Baru)' ? latestBullFvgIdx : bestBullFvgIdx
    int targetBearFvg = fvgDisplayMode == '1 Terbaru (Paling Baru)' ? latestBearFvgIdx : bestBearFvgIdx

    if fvgDisplayMode != 'Semua Gap Aktif'
        for i = 0 to array.size(fvgList) - 1
            FVG fvg = array.get(fvgList, i)
            if not fvg.isMitigated
                if (fvgDisplayMode != 'Nonaktifkan') and (i == targetBullFvg or i == targetBearFvg)
                    box.set_bgcolor(fvg.boxId, fvg.isBullish ? colorBullFVG : colorBearFVG)
                    box.set_border_color(fvg.boxId, fvg.isBullish ? color.new(#10b981, 40) : color.new(#ef4444, 40))
                    box.set_extend(fvg.boxId, extend.right)
                    if showFVGLabels
                        box.set_text(fvg.boxId, fvg.isBullish ? 'Bullish FVG (Valid Imbalance)' : 'Bearish FVG (Valid Imbalance)')
                        box.set_text_size(fvg.boxId, size.tiny)
                        box.set_text_color(fvg.boxId, color.white)
                        box.set_text_valign(fvg.boxId, text.align_center)
                        box.set_text_halign(fvg.boxId, text.align_center)
                else
                    box.set_bgcolor(fvg.boxId, color.new(color.black, 100))
                    box.set_border_color(fvg.boxId, color.new(color.black, 100))
                    box.set_extend(fvg.boxId, extend.none)
                    box.set_right(fvg.boxId, bar_index)
                    box.set_text(fvg.boxId, '')

while array.size(fvgList) > 15
    FVG oldFvg = array.shift(fvgList)
    box.delete(oldFvg.boxId)


//+------------------------------------------------------------------+
//|    MODUL 6: 9 POLA CANDLESTICK KONFIRMASI (BULLISH & BEARISH)   |
//+------------------------------------------------------------------+

// (Geometri Lilin cRange, cBody, upperWick, lowerWick, isGreen, isRed, validSize & Volume sudah didefinisikan secara global)

// -------------------------------------------------------------
// A. 9 MACAM POLA KONFIRMASI / REJECTION BULLISH :
// 1. Hammer (ekor bawah panjang >= 1.8x body, body kecil di atas, rejection harga bawah)
bool isBullHammer = validSize and (lowerWick >= 1.8 * cBody) and (upperWick <= cBody * 0.8) and (close >= low + cRange * 0.55)

// 2. Pin Bar Bullish (ekor bawah panjang >= 60% range, body kecil di area atas)
bool isBullPinBar = validSize and (lowerWick >= 0.60 * cRange) and (math.min(open, close) >= low + cRange * 0.50)

// 3. Bullish Engulfing (candle hijau menelan body candle merah sebelumnya)
bool isBullEngulf = validSize and isGreen and isRed[1] and (close >= open[1]) and (open <= close[1]) and (cBody >= cBody[1] * 0.95)

// 4. Morning Star (3 candle: merah -> body kecil -> hijau kuat tutup > 50% candle merah)
bool isMorningStar = (cRange[2] >= syminfo.mintick * 4) and isRed[2] and (cBody[1] <= cBody[2] * 0.55) and isGreen and (close >= (open[2] + close[2]) / 2)

// 5. Piercing Line (candle hijau buka di bawah/dekat close merah, tutup > 50% body merah)
bool isPiercingLine = validSize and isRed[1] and isGreen and (open <= close[1] * 1.0005) and (close > (open[1] + close[1]) / 2) and (close < open[1])

// 6. Three White Soldiers (3 candle hijau berturut-turut dengan penutupan semakin tinggi)
bool isThreeWhiteSoldiers = isGreen and isGreen[1] and isGreen[2] and (close > close[1]) and (close[1] > close[2]) and (cBody > cRange * 0.35) and (cBody[1] > cRange[1] * 0.35)

// 7. Doji Rejection Bullish (body sangat kecil <= 18% range, ekor bawah panjang >= 50% range)
bool isBullDojiRejection = validSize and (cBody <= cRange * 0.18) and (lowerWick >= cRange * 0.50)

// 8. Bullish Inside Bar (candle [1] di dalam range [2], candle saat ini hijau breakout ke atas)
bool isBullInsideBar = (high[1] <= high[2]) and (low[1] >= low[2]) and isGreen and (close > high[1])

// 9. Two Candle Rejection Bullish (ekor bawah panjang pada candle sebelumnya/saat ini, diikuti penutupan hijau kuat)
bool isBullTwoCandleRejection = (lowerWick[1] >= cRange[1] * 0.45 or lowerWick >= cRange * 0.45) and isGreen and (close > close[1])

// 10. Rebound Dinamis EMA 8/21 (Ekor Bawah >= 30% Range, Rejection Zona EMA & Tutup Hijau)
bool isBullEmaBounce = validSize and isGreen and (lowerWick >= cRange * 0.30) and (low <= math.max(ema8, ema21) * 1.0010) and (close >= ema8)

// Evaluasi Nama Pola Bullish
string bullPatternName = ''
if isBullEngulf
    bullPatternName := 'Bullish Engulfing'
else if isMorningStar
    bullPatternName := 'Morning Star'
else if isThreeWhiteSoldiers
    bullPatternName := 'Three White Soldiers'
else if isPiercingLine
    bullPatternName := 'Piercing Line'
else if isBullHammer
    bullPatternName := 'Hammer'
else if isBullPinBar
    bullPatternName := 'Pin Bar Bullish'
else if isBullDojiRejection
    bullPatternName := 'Doji Rejection'
else if isBullInsideBar
    bullPatternName := 'Bullish Inside Bar'
else if isBullTwoCandleRejection
    bullPatternName := 'Two Candle Rejection'
else if isBullEmaBounce
    bullPatternName := 'EMA 8/21 Bounce'

bool hasBullPattern = bullPatternName != ''

// -------------------------------------------------------------
// B. 9 MACAM POLA KONFIRMASI / REJECTION BEARISH :
// 1. Shooting Star (ekor atas panjang >= 1.8x body, body kecil di bawah, rejection harga atas)
bool isBearShootingStar = validSize and (upperWick >= 1.8 * cBody) and (lowerWick <= cBody * 0.8) and (close <= high - cRange * 0.55)

// 2. Pin Bar Bearish (ekor atas panjang >= 60% range, body kecil di area bawah)
bool isBearPinBar = validSize and (upperWick >= 0.60 * cRange) and (math.max(open, close) <= low + cRange * 0.50)

// 3. Bearish Engulfing (candle merah menelan body candle hijau sebelumnya)
bool isBearEngulf = validSize and isRed and isGreen[1] and (close <= open[1]) and (open >= close[1]) and (cBody >= cBody[1] * 0.95)

// 4. Dark Cloud Cover (candle merah buka di atas/dekat close hijau, tutup < 50% body hijau)
bool isDarkCloudCover = validSize and isGreen[1] and isRed and (open >= close[1] * 0.9995) and (close < (open[1] + close[1]) / 2) and (close > open[1])

// 5. Evening Star (3 candle: hijau -> body kecil -> merah kuat tutup < 50% candle hijau)
bool isEveningStar = (cRange[2] >= syminfo.mintick * 4) and isGreen[2] and (cBody[1] <= cBody[2] * 0.55) and isRed and (close <= (open[2] + close[2]) / 2)

// 6. Three Black Crows (3 candle merah berturut-turut dengan penutupan semakin rendah)
bool isThreeBlackCrows = isRed and isRed[1] and isRed[2] and (close < close[1]) and (close[1] < close[2]) and (cBody > cRange * 0.35) and (cBody[1] > cRange[1] * 0.35)

// 7. Doji Rejection Bearish (body sangat kecil <= 18% range, ekor atas panjang >= 50% range)
bool isBearDojiRejection = validSize and (cBody <= cRange * 0.18) and (upperWick >= cRange * 0.50)

// 8. Bearish Inside Bar (candle [1] di dalam range [2], candle saat ini merah breakdown ke bawah)
bool isBearInsideBar = (high[1] <= high[2]) and (low[1] >= low[2]) and isRed and (close < low[1])

// 9. Two Candle Rejection Bearish (ekor atas panjang pada candle sebelumnya/saat ini, diikuti penutupan merah kuat)
bool isBearTwoCandleRejection = (upperWick[1] >= cRange[1] * 0.45 or upperWick >= cRange * 0.45) and isRed and (close < close[1])

// 10. Rejection Dinamis EMA 8/21 (Ekor Atas >= 30% Range, Rejection Zona EMA & Tutup Merah)
bool isBearEmaBounce = validSize and isRed and (upperWick >= cRange * 0.30) and (high >= math.min(ema8, ema21) * 0.9990) and (close <= ema8)

// Evaluasi Nama Pola Bearish
string bearPatternName = ''
if isBearEngulf
    bearPatternName := 'Bearish Engulfing'
else if isEveningStar
    bearPatternName := 'Evening Star'
else if isThreeBlackCrows
    bearPatternName := 'Three Black Crows'
else if isDarkCloudCover
    bearPatternName := 'Dark Cloud Cover'
else if isBearShootingStar
    bearPatternName := 'Shooting Star'
else if isBearPinBar
    bearPatternName := 'Pin Bar Bearish'
else if isBearDojiRejection
    bearPatternName := 'Doji Rejection'
else if isBearInsideBar
    bearPatternName := 'Bearish Inside Bar'
else if isBearTwoCandleRejection
    bearPatternName := 'Two Candle Rejection'
else if isBearEmaBounce
    bearPatternName := 'EMA 8/21 Rejection'

bool hasBearPattern = bearPatternName != ''


//+------------------------------------------------------------------+
//|    MODUL 7: 5 ATURAN INSTITUSIONAL (BREAKOUT, FAKEOUT & PULLBACK)|
//+------------------------------------------------------------------+

// Rentang Ribbon EMA 8 & 21
float emaTop = math.max(ema8, ema21)
float emaBtm = math.min(ema8, ema21)

// ===================================================================
// ATURAN 4: CANDLE BREAK (BODY CANDLE BENAR-BENAR CLOSE MELEWATI LEVEL)
// Bukan hanya ekor (wick), tapi body candle solid close melewati Resistance/Support
// ===================================================================
bool isResBodyBreak = not na(majorResistance[1]) and (close > majorResistance[1]) and (close[1] <= majorResistance[1]) and isGreen and (cBody >= cRange * 0.45)
bool isSupBodyBreak = not na(majorSupport[1]) and (close < majorSupport[1]) and (close[1] >= majorSupport[1]) and isRed and (cBody >= cRange * 0.45)

// ===================================================================
// ATURAN 1: BREAKOUT VALID BUY
// - Candle close jelas di luar level Resistance (isResBodyBreak)
// - Volume meningkat saat breakout (isVolIncreasing)
// - Searah dengan trend utama: EMA 8 > EMA 21 dan Close > EMA 125
// ===================================================================
bool validBreakoutBuy = isResBodyBreak and (not filterVolume or isVolIncreasing) and (close > ema125) and (ema8 > ema21)

// ===================================================================
// ATURAN 3: BREAKOUT SELL
// - Harga berada di bawah EMA 125 & EMA 8 berada di bawah EMA 21
// - Breakout support dengan candle bearish yang kuat (isSupBodyBreak)
// - Volume meningkat saat breakout (isVolIncreasing)
// - Searah dengan trend utama bearish
// ===================================================================
bool validBreakoutSell = isSupBodyBreak and (not filterVolume or isVolIncreasing) and (close < ema125) and (ema8 < ema21)

// ===================================================================
// ATURAN 2: FALSE BREAKOUT (FAKEOUT WICK SWEEP)
// - Hanya wick yang menembus level, candle close kembali di dalam area
// - Volume tidak kuat / mengecil (isVolDecreasing)
// - Gagal bertahan di luar level saat retrace
// - Berlawanan dengan trend EMA (Wick ke atas tapi EMA bearish atau close < EMA 125)
// ===================================================================
bool isResistanceFakeout = not na(majorResistance[1]) and (high > majorResistance[1]) and (close <= majorResistance[1]) and (upperWick >= cRange * 0.40) and (isVolDecreasing or isRed or (close < ema125) or (ema8 < ema21))
bool isSupportFakeout    = not na(majorSupport[1]) and (low < majorSupport[1]) and (close >= majorSupport[1]) and (lowerWick >= cRange * 0.40) and (isVolDecreasing or isGreen or (close > ema125) or (ema8 > ema21))

// Plot Label Visual Breakout & Fakeout di Chart
if showBreakoutLabels
    if validBreakoutBuy
        label.new(bar_index, high + (atr14 * 0.25), 'Breakout 🚀', color = color.new(#089981, 10), textcolor = color.white, style = label.style_label_down, size = size.tiny)
    if validBreakoutSell
        label.new(bar_index, low - (atr14 * 0.25), 'Breakout 🚀', color = color.new(#f23645, 10), textcolor = color.white, style = label.style_label_up, size = size.tiny)

if showFakeoutLabels
    if isResistanceFakeout
        label.new(bar_index, high + (atr14 * 0.25), 'Fakeout ⚡', color = color.new(#7f1d1d, 10), textcolor = #fca5a5, style = label.style_label_down, size = size.tiny)
    if isSupportFakeout
        label.new(bar_index, low - (atr14 * 0.25), 'Fakeout ⚡', color = color.new(#064e3b, 10), textcolor = #86efac, style = label.style_label_up, size = size.tiny)

// ===================================================================
// SISTEM ROLE REVERSAL: RBS (Resistance Became Support) & SBR (Support Became Resistance)
// ===================================================================
var float activeRBS     = na
var int   activeRBSBar  = na
var bool  rbsRetested   = false

var float activeSBR     = na
var int   activeSBRBar  = na
var bool  sbrRetested   = false

// 1. Saat Resistance Ditembus Valid -> Level Berubah Peran Menjadi Support Baru (RBS)
if isResBodyBreak
    activeRBS    := majorResistance[1]
    activeRBSBar := bar_index
    rbsRetested  := false

// Invalidate RBS jika harga breakdown jauh kembali ke bawah level RBS
if not na(activeRBS) and (close < activeRBS - (atr14 * 0.5))
    activeRBS := na

// 2. Saat Support Ditembus Valid -> Level Berubah Peran Menjadi Resistance Baru (SBR)
if isSupBodyBreak
    activeSBR    := majorSupport[1]
    activeSBRBar := bar_index
    sbrRetested  := false

// Invalidate SBR jika harga breakout jauh kembali ke atas level SBR
if not na(activeSBR) and (close > activeSBR + (atr14 * 0.5))
    activeSBR := na

// 3. Deteksi Retest / Sentuhan RBS (Peluang Bouncing Bullish)
bool touchRBS = not na(activeRBS) and (low <= activeRBS + (atr14 * 0.25)) and (close >= activeRBS - (atr14 * 0.15))
if touchRBS
    rbsRetested := true

// 4. Deteksi Retest / Sentuhan SBR (Peluang Rejection Bearish)
bool touchSBR = not na(activeSBR) and (high >= activeSBR - (atr14 * 0.25)) and (close <= activeSBR + (atr14 * 0.15))
if touchSBR
    sbrRetested := true

// Label Khusus saat Lilin Memantul di RBS / Tertolak di SBR
if showRBS_SBR
    if touchRBS and hasBullPattern
        label.new(bar_index, low - (atr14 * 0.30), 'RBS 💎', color = color.new(#00838f, 10), textcolor = #e0f7fa, style = label.style_label_up, size = size.tiny)
    if touchSBR and hasBearPattern
        label.new(bar_index, high + (atr14 * 0.30), 'SBR 💎', color = color.new(#e65100, 10), textcolor = #fff3e0, style = label.style_label_down, size = size.tiny)

// Visual Garis & Label RBS / SBR Memanjang ke Kanan
var line  lineRBS = na
var label lblRBS  = na
var line  lineSBR = na
var label lblSBR  = na

if barstate.islast and showRBS_SBR
    line.delete(lineRBS)
    label.delete(lblRBS)
    line.delete(lineSBR)
    label.delete(lblSBR)

    if not na(activeRBS)
        lineRBS := line.new(activeRBSBar, activeRBS, bar_index + srLabelOffset, activeRBS, color = colorRBS, width = 2, style = line.style_dashed, extend = extendStyle)
        string rbsStr = 'RBS (Support Baru): ' + str.tostring(activeRBS, '#.##') + (rbsRetested ? ' [Retested ✅]' : ' [Menunggu Retest ⏳]')
        lblRBS  := label.new(bar_index + srLabelOffset, activeRBS, rbsStr, color = color.new(colorRBS, 20), textcolor = color.white, style = label.style_label_left, size = size.tiny)

    if not na(activeSBR)
        lineSBR := line.new(activeSBRBar, activeSBR, bar_index + srLabelOffset, activeSBR, color = colorSBR, width = 2, style = line.style_dashed, extend = extendStyle)
        string sbrStr = 'SBR (Resistance Baru): ' + str.tostring(activeSBR, '#.##') + (sbrRetested ? ' [Retested ✅]' : ' [Menunggu Retest ⏳]')
        lblSBR  := label.new(bar_index + srLabelOffset, activeSBR, sbrStr, color = color.new(colorSBR, 20), textcolor = color.white, style = label.style_label_left, size = size.tiny)

// ===================================================================
// ATURAN 5: CANDLE KOREKSI (PULLBACK ADALAH PELUANG, BUKAN PERUBAHAN TREND)
// Bullish: close > ema125 & ema8 > ema21, candle merah turun mendekati EMA 8/21
// Bearish: close < ema125 & ema8 < ema21, candle hijau naik mendekati EMA 8/21
// ===================================================================
bool isPullbackBuyZone = (low <= emaTop * 1.0015) and (math.min(open, close) >= ema125) and (low >= ema125 * 0.9980)
bool isPullbackSellZone = (high >= emaBtm * 0.9985) and (math.max(open, close) <= ema125) and (high <= ema125 * 1.0020)

bool nearMajorSup = not na(majorSupport) and (low <= majorSupport * 1.0015) and (close >= majorSupport * 0.9980)
bool nearMinorSup = not na(minorSupport) and (low <= minorSupport * 1.0010) and (close >= minorSupport * 0.9985)
bool idmBullValidRecent = isBullIDMSwept and not na(lastBullIDMSweepBar) and (bar_index - lastBullIDMSweepBar <= 5)
bool idmBearValidRecent = isBearIDMSwept and not na(lastBearIDMSweepBar) and (bar_index - lastBearIDMSweepBar <= 5)

bool bullZoneConfluence = touchDemandOB or touchDemandOB[1] or touchDemandOB[2] or touchBullFVG or touchBullFVG[1] or touchBullFVG[2] or (inGoldenZone and isFiboForBuy) or (inGoldenZone[1] and isFiboForBuy) or (inGoldenZone[2] and isFiboForBuy) or nearMajorSup or nearMajorSup[1] or nearMinorSup or nearMinorSup[1] or touchRBS or touchRBS[1] or isSSLSweep or isSSLSweep[1] or isSSLSweep[2] or idmBullValidRecent

bool nearMajorRes = not na(majorResistance) and (high >= majorResistance * 0.9985) and (close <= majorResistance * 1.0020)
bool nearMinorRes = not na(minorResistance) and (high >= minorResistance * 0.9990) and (close <= minorResistance * 1.0015)
bool bearZoneConfluence = touchSupplyOB or touchSupplyOB[1] or touchSupplyOB[2] or touchBearFVG or touchBearFVG[1] or touchBearFVG[2] or (inGoldenZone and isFiboForSell) or (inGoldenZone[1] and isFiboForSell) or (inGoldenZone[2] and isFiboForSell) or nearMajorRes or nearMajorRes[1] or nearMinorRes or nearMinorRes[1] or touchSBR or touchSBR[1] or isBSLSweep or isBSLSweep[1] or isBSLSweep[2] or idmBearValidRecent


//+------------------------------------------------------------------+
//|    MODUL 8: FILTER KEAMANAN (WASPADAI SINYAL FALSE DALAM EMA)    |
//+------------------------------------------------------------------+

// 1. EMA 8 dan 21 sering bolak-balik (Chop / Sideways)
bool emaCrossed = ta.cross(ema8, ema21)
int emaCrossCount = 0
for k = 0 to 10
    if emaCrossed[k]
        emaCrossCount += 1

bool isEMASideways = ((emaCrossCount >= 2) and (math.abs(ema8 - ema21) < (atr14 * 0.20))) or (math.abs(ema8 - ema21) < (atr14 * 0.10))

// 2. Harga bolak-balik menembus EMA 125 (Ranging di sekitar EMA 125)
// Whipsaw hanya aktif jika harga sedang terjebak dekat EMA 125 (< 1x ATR). Jika harga sudah ekspansi, filter lepas!
bool closeCross125 = ta.cross(close, ema125)
int cross125Count = 0
for k = 0 to 9
    if closeCross125[k]
        cross125Count += 1

bool isWhipsaw125 = (cross125Count >= 2) and (math.abs(close - ema125) < (atr14 * 1.0))

// 3. Candle sudah terlalu jauh dari EMA (Overextended Risk)
bool isOverextendedBuy  = (close - ema8) > (atr14 * maxAtrExtension)
bool isOverextendedSell = (ema8 - close) > (atr14 * maxAtrExtension)

// 4. Struktur Market HH-HL & LH-LL
bool isBullStructure = (marketTrend == 1) or (lastSwingStatus == 'HH') or (lastSwingStatus == 'HL') or (not na(lastSwingLow) and not na(prevSwingLow) and lastSwingLow >= prevSwingLow)
bool isBearStructure = (marketTrend == -1) or (lastSwingStatus == 'LH') or (lastSwingStatus == 'LL') or (not na(lastSwingHigh) and not na(prevSwingHigh) and lastSwingHigh <= prevSwingHigh)

// 5. Filter RSI Exhaustion (Cegah SELL di Dasar Lembah / BUY di Puncak Harga)
// Dilarang SELL jika RSI sudah sangat jenuh jual (RSI < 32), dilarang BUY jika RSI sudah jenuh beli (RSI > 68)
bool condBuyRsiSafe  = not filterRsiExhaust or (rsi14 <= 68 and rsi14 >= 30)
bool condSellRsiSafe = not filterRsiExhaust or (rsi14 >= 32 and rsi14 <= 70)


//+------------------------------------------------------------------+
//|    MODUL 9: EKSEKUSI SINYAL TRADING (3-ENGINE MOMENTUM SYSTEM)   |
//+------------------------------------------------------------------+

// Timing Sinyal (Closed Bar vs Realtime)
bool triggerReady = (sigMode == 'Selesai Candle (Closed Bar - Non Repainting)') ? barstate.isconfirmed : true

// Filter Jeda Lilin Terkonfirmasi Terakhir
var int lastConfirmedBuyBar  = -100
var int lastConfirmedSellBar = -100

// Mode Izin Sinyal
bool isUltraSniperMode = (signalStyle == 'Ultra-Sniper Trend Pullback (Wajib Arah Tren + Koreksi EMA 8/21 + Lilin Konfirmasi)')
bool allowSniper       = (signalStyle == 'Semua Momentum (SMC Sniper + EMA Pullback + Breakout)') or (signalStyle == 'SMC Sniper Reversal Saja (Pucuk/Lembah)')
bool allowPullback     = isUltraSniperMode or (signalStyle == 'Semua Momentum (SMC Sniper + EMA Pullback + Breakout)') or (signalStyle == 'EMA Pullback Saja (Trend Klasik)')
bool allowBreakout     = (signalStyle == 'Semua Momentum (SMC Sniper + EMA Pullback + Breakout)') or (signalStyle == 'Valid Breakout Saja (Momentum Tembusan)')

// Filter Volume Sinyal
bool condBuyVolume  = not filterVolume or isVolIncreasing or (volume >= volMa20 * 0.95)
bool condSellVolume = not filterVolume or isVolIncreasing or (volume >= volMa20 * 0.95)

// -------------------------------------------------------------
// ENGINE 1: SMC SNIPER REVERSAL ENTRY (MENANGKAP PUCUK & LEMBAH)
// Masuk di awal pembalikan arah SEBELUM lilin meledak, tanpa menunggu EMA 8/21 berbalik arah!
// -------------------------------------------------------------
bool condBuySniper = htfAllowsBuy and bullZoneConfluence and hasBullPattern and condBuyVolume and condBuyRsiSafe and (not filterChop or not isEMASideways)
bool condSellSniper = htfAllowsSell and bearZoneConfluence and hasBearPattern and condSellVolume and condSellRsiSafe and (not filterChop or not isEMASideways)

// -------------------------------------------------------------
// ENGINE 2: TRIPLE EMA PULLBACK ENTRY (TREND CONTINUATION KLASIK & ULTRA-SNIPER)
// -------------------------------------------------------------
// 1. Searah trend utama: EMA 8 > EMA 21 dan Close > EMA 125 (opsi strict: EMA 8 > 21 > 125)
bool condEmaBuyTrend    = strictEmaHierarchy ? ((close > ema125) and (ema8 > ema21) and (ema21 > ema125)) : ((close > ema125) and (ema8 > ema21))
bool condBuyPullback    = isPullbackBuyZone or isPullbackBuyZone[1] or isPullbackBuyZone[2] or touchRBS or touchRBS[1] or (not na(majorResistance) and low <= majorResistance * 1.0015 and close >= majorResistance * 0.9985)
bool condBuyFilterPass  = (not filterChop or not isEMASideways) and (not filter125Whip or not isWhipsaw125) and (not filterOverextended or not isOverextendedBuy) and (not filterStructure or isBullStructure)
bool condBuyConfluence  = (sigConfluence == 'Triple EMA + Candle Pattern (Pullback)') ? true : bullZoneConfluence

bool condBuyPullbackEntry = htfAllowsBuy and condEmaBuyTrend and condBuyPullback and hasBullPattern and condBuyFilterPass and condBuyConfluence and condBuyVolume and condBuyRsiSafe

// Aturan Khusus Mode Ultra-Sniper:
// - Arah Trend Wajib Sempurna: HTF H1 Bullish + Hierarki EMA 8 > 21 > 125 + Struktur Bullish + Bukan Sideways
bool ultraBuyTrend = htfAllowsBuy and (close > ema125) and (ema8 > ema21) and (ema21 > ema125) and (marketTrend == 1 or not filterStructure or isBullStructure) and (not filterChop or not isEMASideways) and (not filter125Whip or not isWhipsaw125) and (not filterOverextended or not isOverextendedBuy)
// - Menunggu Pullback ke EMA 8 atau EMA 21:
bool ultraBuyPullbackTouch = (low <= emaTop * 1.0010) and (low >= ema125 * 0.9985) and (close > ema125)
bool ultraBuyPullbackValid = ultraBuyPullbackTouch or ultraBuyPullbackTouch[1] or ultraBuyPullbackTouch[2] or isPullbackBuyZone or isPullbackBuyZone[1] or isPullbackBuyZone[2] or touchRBS or touchRBS[1]
// - Menunggu Candle Konfirmasi Terbentuk:
bool ultraBuyCandleConfirm = isGreen and (close >= ema8) and hasBullPattern
bool condBuyUltraSniper     = isUltraSniperMode and ultraBuyTrend and ultraBuyPullbackValid and ultraBuyCandleConfirm and condBuyVolume and condBuyRsiSafe

bool condEmaSellTrend   = strictEmaHierarchy ? ((close < ema125) and (ema8 < ema21) and (ema21 < ema125)) : ((close < ema125) and (ema8 < ema21))
bool condSellPullback   = isPullbackSellZone or isPullbackSellZone[1] or isPullbackSellZone[2] or touchSBR or touchSBR[1] or (not na(majorSupport) and high >= majorSupport * 0.9985 and close <= majorSupport * 1.0015)
bool condSellFilterPass = (not filterChop or not isEMASideways) and (not filter125Whip or not isWhipsaw125) and (not filterOverextended or not isOverextendedSell) and (not filterStructure or isBearStructure)
bool condSellConfluence = (sigConfluence == 'Triple EMA + Candle Pattern (Pullback)') ? true : bearZoneConfluence

bool condSellPullbackEntry = htfAllowsSell and condEmaSellTrend and condSellPullback and hasBearPattern and condSellFilterPass and condSellConfluence and condSellVolume and condSellRsiSafe

// Aturan Khusus Mode Ultra-Sniper:
// - Arah Trend Wajib Sempurna: HTF H1 Bearish + Hierarki EMA 8 < 21 < 125 + Struktur Bearish + Bukan Sideways
bool ultraSellTrend = htfAllowsSell and (close < ema125) and (ema8 < ema21) and (ema21 < ema125) and (marketTrend == -1 or not filterStructure or isBearStructure) and (not filterChop or not isEMASideways) and (not filter125Whip or not isWhipsaw125) and (not filterOverextended or not isOverextendedSell)
// - Menunggu Pullback ke EMA 8 atau EMA 21:
bool ultraSellPullbackTouch = (high >= emaBtm * 0.9990) and (high <= ema125 * 1.0015) and (close < ema125)
bool ultraSellPullbackValid = ultraSellPullbackTouch or ultraSellPullbackTouch[1] or ultraSellPullbackTouch[2] or isPullbackSellZone or isPullbackSellZone[1] or isPullbackSellZone[2] or touchSBR or touchSBR[1]
// - Menunggu Candle Konfirmasi Terbentuk:
bool ultraSellCandleConfirm = isRed and (close <= ema8) and hasBearPattern
bool condSellUltraSniper     = isUltraSniperMode and ultraSellTrend and ultraSellPullbackValid and ultraSellCandleConfirm and condSellVolume and condSellRsiSafe

// -------------------------------------------------------------
// ENGINE 3: VALID BREAKOUT MOMENTUM ENTRY (TEMBUSAN LEVEL SOLID)
// -------------------------------------------------------------
bool condBuyBreakout = htfAllowsBuy and validBreakoutBuy and condBuyRsiSafe
bool condSellBreakout = htfAllowsSell and validBreakoutSell and condSellRsiSafe

// Evaluasi Status Engine yang Sedang Aktif
bool isBuySniperActive    = allowSniper and condBuySniper
bool isSellSniperActive   = allowSniper and condSellSniper

bool isBuyBreakoutActive  = allowBreakout and condBuyBreakout
bool isSellBreakoutActive = allowBreakout and condSellBreakout

bool isBuyPullbackActive  = allowPullback and (isUltraSniperMode ? condBuyUltraSniper : condBuyPullbackEntry)
bool isSellPullbackActive = allowPullback and (isUltraSniperMode ? condSellUltraSniper : condSellPullbackEntry)

bool rawBuySignal  = isBuySniperActive or isBuyBreakoutActive or isBuyPullbackActive
bool rawSellSignal = isSellSniperActive or isSellBreakoutActive or isSellPullbackActive

bool rawBuyTrigger  = triggerReady and rawBuySignal and not rawSellSignal
bool rawSellTrigger = triggerReady and rawSellSignal and not rawBuySignal

// Kategori & Tipe Sinyal Terpilih
string activeSignalCategoryBuy  = isUltraSniperMode ? 'BUY ULTRA-SNIPER 🎯' : isBuySniperActive ? 'BUY SNIPER 🎯' : isBuyBreakoutActive ? 'BUY BREAKOUT 🚀' : 'BUY PULLBACK 🟢'
string activeSignalCategorySell = isUltraSniperMode ? 'SELL ULTRA-SNIPER 🎯' : isSellSniperActive ? 'SELL SNIPER 🎯' : isSellBreakoutActive ? 'SELL BREAKOUT 🚀' : 'SELL PULLBACK 🔴'

// ===================================================================
// SISTEM TRADE LIFECYCLE & STATE MACHINE (ANTI-SPAM 1 SETUP 1 TRADE)
// ===================================================================
var bool  inBuyTrade        = false
var bool  inSellTrade       = false
var float activeEntryPrice  = na
var float activeSLPrice     = na
var float activeTPPrice     = na
var int   activeTradeBar    = na
var string activeTradeType  = 'None'

var label[] tpHitLabels     = array.new_label()
var line    lineActiveTP    = na
var line    lineActiveSL    = na
var line    lineActiveEntry = na

// 1. Evaluasi Penyelesaian Posisi Berjalan (TP Hit / SL Hit / Invalidation)
if inBuyTrade
    if high >= activeTPPrice
        if showTpHitMarkers
            label hitLbl = label.new(bar_index, activeTPPrice, 'TP HIT 🎯 (+2R)', color = color.new(#059669, 10), textcolor = color.white, style = label.style_label_down, size = size.tiny)
            array.push(tpHitLabels, hitLbl)
            if array.size(tpHitLabels) > 25
                label.delete(array.shift(tpHitLabels))
        inBuyTrade       := false
        activeEntryPrice := na
        activeSLPrice    := na
        activeTPPrice    := na
    else if low <= activeSLPrice
        if showTpHitMarkers
            label slLbl = label.new(bar_index, activeSLPrice, 'SL HIT ❌ (-1R)', color = color.new(#dc2626, 10), textcolor = color.white, style = label.style_label_up, size = size.tiny)
            array.push(tpHitLabels, slLbl)
            if array.size(tpHitLabels) > 25
                label.delete(array.shift(tpHitLabels))
        inBuyTrade       := false
        activeEntryPrice := na
        activeSLPrice    := na
        activeTPPrice    := na
    else if lastStructName == 'BEARISH CHoCH' and (bar_index - activeTradeBar >= 3)
        inBuyTrade       := false
        activeEntryPrice := na
        activeSLPrice    := na
        activeTPPrice    := na

if inSellTrade
    if low <= activeTPPrice
        if showTpHitMarkers
            label hitLbl = label.new(bar_index, activeTPPrice, 'TP HIT 🎯 (+2R)', color = color.new(#059669, 10), textcolor = color.white, style = label.style_label_up, size = size.tiny)
            array.push(tpHitLabels, hitLbl)
            if array.size(tpHitLabels) > 25
                label.delete(array.shift(tpHitLabels))
        inSellTrade      := false
        activeEntryPrice := na
        activeSLPrice    := na
        activeTPPrice    := na
    else if high >= activeSLPrice
        if showTpHitMarkers
            label slLbl = label.new(bar_index, activeSLPrice, 'SL HIT ❌ (-1R)', color = color.new(#dc2626, 10), textcolor = color.white, style = label.style_label_down, size = size.tiny)
            array.push(tpHitLabels, slLbl)
            if array.size(tpHitLabels) > 25
                label.delete(array.shift(tpHitLabels))
        inSellTrade      := false
        activeEntryPrice := na
        activeSLPrice    := na
        activeTPPrice    := na
    else if lastStructName == 'BULLISH CHoCH' and (bar_index - activeTradeBar >= 3)
        inSellTrade      := false
        activeEntryPrice := na
        activeSLPrice    := na
        activeTPPrice    := na

// 2. Izin Kemunculan Sinyal Baru Sesuai Pengaturan User
bool allowNewBuy = (sigFrequency == '1 Sinyal Per Siklus Setup (Anti-Spam Pro)') ? (not inBuyTrade and (bar_index - lastConfirmedBuyBar >= 6)) : (sigFrequency == 'Cooldown Dinamis (Jeda 12 Lilin)') ? (bar_index - lastConfirmedBuyBar >= 12) : (bar_index - lastConfirmedBuyBar >= 3)

bool allowNewSell = (sigFrequency == '1 Sinyal Per Siklus Setup (Anti-Spam Pro)') ? (not inSellTrade and (bar_index - lastConfirmedSellBar >= 6)) : (sigFrequency == 'Cooldown Dinamis (Jeda 12 Lilin)') ? (bar_index - lastConfirmedSellBar >= 12) : (bar_index - lastConfirmedSellBar >= 3)

bool buySignal  = rawBuyTrigger and allowNewBuy
bool sellSignal = rawSellTrigger and allowNewSell

var string activePatternText = ''

// Plot Sinyal di Chart
bool isButtonArrow = signalMarkerStyle == 'Tombol Panah di Candle (▲ BUY / ▼ SELL)'
bool isArrowOnly   = signalMarkerStyle == 'Panah Murni Tanpa Tulisan (Arrow Shape)'
bool isPureSymbol  = signalMarkerStyle == 'Simbol Panah Minimalis (▲ / ▼)'
bool isFullBadge   = signalMarkerStyle == 'Kotak Detail SL/TP (Badge Panjang)'

// Plot Sinyal Arrow Murni di Chart
plotshape(showSignals and showBuySignal and buySignal and isArrowOnly, title = 'Entry BUY Arrow', style = shape.arrowup, location = location.belowbar, color = color.new(#10b981, 0), size = size.normal)
plotshape(showSignals and showSellSignal and sellSignal and isArrowOnly, title = 'Entry SELL Arrow', style = shape.arrowdown, location = location.abovebar, color = color.new(#ef4444, 0), size = size.normal)

// Eksekusi Entry & Marker di Candle
if buySignal
    float slBuyBase = isUltraSniperMode ? (math.min(math.min(low, low[1]), ema21) - (atr14 * 0.35)) : (isBuyBreakoutActive ? (not na(majorResistance[1]) ? majorResistance[1] - (atr14 * 0.4) : low - (atr14 * 0.4)) : (math.min(low, not na(majorSupport) ? majorSupport : low) - (atr14 * 0.35)))
    float slBuy     = slBuyBase
    float riskBuy   = math.max(math.abs(close - slBuy), atr14 * 0.4)
    float tpBuy     = close + (riskBuy * 2.0)

    inBuyTrade       := true
    inSellTrade      := false
    activeEntryPrice := close
    activeSLPrice    := slBuy
    activeTPPrice    := tpBuy
    activeTradeBar   := bar_index
    activeTradeType  := activeSignalCategoryBuy

    if barstate.isconfirmed
        lastConfirmedBuyBar := bar_index

    activePatternText := isBuyBreakoutActive ? 'Breakout Res' : bullPatternName

    if showSignals and showBuySignal
        if isButtonArrow or isPureSymbol
            string buyTip = activeSignalCategoryBuy + ' (' + (isBuyBreakoutActive ? 'Breakout' : bullPatternName) + ')\nEntry: ' + str.tostring(close, '#.##') + '\nSL: ' + str.tostring(slBuy, '#.##') + '\nTP (1:2): ' + str.tostring(tpBuy, '#.##')
            string buyText = isPureSymbol ? '▲' : '▲ BUY'
            label.new(bar_index, low - (atr14 * 0.20), buyText, color = color.new(#059669, 0), textcolor = color.white, style = label.style_label_up, size = size.small, tooltip = buyTip)
        else if isFullBadge
            string buyDetail = isBuyBreakoutActive ? 'Breakout Res' : bullPatternName
            string buyLabelText = activeSignalCategoryBuy + ' (' + buyDetail + ')\nSL: ' + str.tostring(slBuy, '#.##') + ' | TP (1:2): ' + str.tostring(tpBuy, '#.##')
            color  buyLabelBg   = isBuySniperActive ? color.new(#047857, 10) : isBuyBreakoutActive ? color.new(#0284c7, 10) : color.new(#065f46, 10)
            label.new(bar_index, low - (atr14 * 0.35), buyLabelText, color = buyLabelBg, textcolor = color.white, style = label.style_label_up, size = size.tiny)

if sellSignal
    float slSellBase = isUltraSniperMode ? (math.max(math.max(high, high[1]), ema21) + (atr14 * 0.35)) : (isSellBreakoutActive ? (not na(majorSupport[1]) ? majorSupport[1] + (atr14 * 0.4) : high + (atr14 * 0.4)) : (math.max(high, not na(majorResistance) ? majorResistance : high) + (atr14 * 0.35)))
    float slSell     = slSellBase
    float riskSell   = math.max(math.abs(slSell - close), atr14 * 0.4)
    float tpSell     = close - (riskSell * 2.0)

    inSellTrade      := true
    inBuyTrade       := false
    activeEntryPrice := close
    activeSLPrice    := slSell
    activeTPPrice    := tpSell
    activeTradeBar   := bar_index
    activeTradeType  := activeSignalCategorySell

    if barstate.isconfirmed
        lastConfirmedSellBar := bar_index

    activePatternText := isSellBreakoutActive ? 'Breakout Sup' : bearPatternName

    if showSignals and showSellSignal
        if isButtonArrow or isPureSymbol
            string sellTip = activeSignalCategorySell + ' (' + (isSellBreakoutActive ? 'Breakout' : bearPatternName) + ')\nEntry: ' + str.tostring(close, '#.##') + '\nSL: ' + str.tostring(slSell, '#.##') + '\nTP (1:2): ' + str.tostring(tpSell, '#.##')
            string sellText = isPureSymbol ? '▼' : '▼ SELL'
            label.new(bar_index, high + (atr14 * 0.20), sellText, color = color.new(#dc2626, 0), textcolor = color.white, style = label.style_label_down, size = size.small, tooltip = sellTip)
        else if isFullBadge
            string sellDetail = isSellBreakoutActive ? 'Breakout Sup' : bearPatternName
            string sellLabelText = activeSignalCategorySell + ' (' + sellDetail + ')\nSL: ' + str.tostring(slSell, '#.##') + ' | TP (1:2): ' + str.tostring(tpSell, '#.##')
            color  sellLabelBg   = isSellSniperActive ? color.new(#be123c, 10) : isSellBreakoutActive ? color.new(#b91c1c, 10) : color.new(#991b1b, 10)
            label.new(bar_index, high + (atr14 * 0.35), sellLabelText, color = sellLabelBg, textcolor = color.white, style = label.style_label_down, size = size.tiny)

// Garis Bantu Visual Target TP & SL Trade Aktif di Lilin Terakhir
if barstate.islast
    line.delete(lineActiveTP)
    line.delete(lineActiveSL)
    line.delete(lineActiveEntry)
    if showActiveTradeLines and (inBuyTrade or inSellTrade) and not na(activeEntryPrice)
        int xEnd = bar_index + srLabelOffset
        lineActiveEntry := line.new(activeTradeBar, activeEntryPrice, xEnd, activeEntryPrice, color = color.new(color.white, 30), width = 1, style = line.style_dotted)
        lineActiveTP    := line.new(activeTradeBar, activeTPPrice, xEnd, activeTPPrice, color = color.new(#10b981, 20), width = 2, style = line.style_dashed)
        lineActiveSL    := line.new(activeTradeBar, activeSLPrice, xEnd, activeSLPrice, color = color.new(#ef4444, 20), width = 2, style = line.style_dashed)

// Preview Label Realtime pada Lilin yang Sedang Berjalan (Live Candle)
var label liveCandleLabel = na
bool isBuyRealtimeCandidate  = allowNewBuy and (isBuyPullbackActive or (allowSniper and condBuySniper) or (allowBreakout and condBuyBreakout))
bool isSellRealtimeCandidate = allowNewSell and (isSellPullbackActive or (allowSniper and condSellSniper) or (allowBreakout and condSellBreakout))

if showSignals and barstate.islast
    label.delete(liveCandleLabel)
    if not barstate.isconfirmed
        if isBuyRealtimeCandidate
            string curCandBuy = isUltraSniperMode ? 'BUY ULTRA-SNIPER' : (allowSniper and condBuySniper) ? 'BUY SNIPER' : (allowBreakout and condBuyBreakout) ? 'BUY BREAKOUT' : 'BUY PULLBACK'
            liveCandleLabel := label.new(bar_index, low - (atr14 * 0.30), '⏳ ▲ BUY', color = color.new(#00838f, 15), textcolor = #e0f7fa, style = label.style_label_up, size = size.small, tooltip = 'Menunggu Close Candle: ' + curCandBuy)
        else if isSellRealtimeCandidate
            string curCandSell = isUltraSniperMode ? 'SELL ULTRA-SNIPER' : (allowSniper and condSellSniper) ? 'SELL SNIPER' : (allowBreakout and condSellBreakout) ? 'SELL BREAKOUT' : 'SELL PULLBACK'
            liveCandleLabel := label.new(bar_index, high + (atr14 * 0.30), '⏳ ▼ SELL', color = color.new(#880e4f, 15), textcolor = #fce4ec, style = label.style_label_down, size = size.small, tooltip = 'Menunggu Close Candle: ' + curCandSell)

// Tracking Sinyal Terkonfirmasi Terakhir untuk Dashboard
var string lastConfirmedSignalText  = 'Menunggu Setup'
var color  lastConfirmedSignalColor = color.new(#94a3b8, 0)
var int    lastConfirmedSignalBar   = na

if buySignal and barstate.isconfirmed
    lastConfirmedSignalText  := activeSignalCategoryBuy + ': ' + (isBuyBreakoutActive ? 'Breakout' : bullPatternName)
    lastConfirmedSignalColor := isUltraSniperMode ? #10b981 : isBuySniperActive ? #10b981 : isBuyBreakoutActive ? #38bdf8 : #059669
    lastConfirmedSignalBar   := bar_index

if sellSignal and barstate.isconfirmed
    lastConfirmedSignalText  := activeSignalCategorySell + ': ' + (isSellBreakoutActive ? 'Breakout' : bearPatternName)
    lastConfirmedSignalColor := isUltraSniperMode ? #ef4444 : isSellSniperActive ? #fb7185 : isSellBreakoutActive ? #f43f5e : #ef4444
    lastConfirmedSignalBar   := bar_index

// Evaluasi Status Realtime Lilin Aktif Detik Ini
string liveSignalStatus = '⚪ Menunggu Setup Valid'
color  liveSignalColor  = color.new(#94a3b8, 0)

if inBuyTrade
    liveSignalStatus := '🟢 POSISI BUY AKTIF (TP: ' + str.tostring(activeTPPrice, '#.##') + ' 🎯)'
    liveSignalColor  := #10b981
else if inSellTrade
    liveSignalStatus := '🔴 POSISI SELL AKTIF (TP: ' + str.tostring(activeTPPrice, '#.##') + ' 🎯)'
    liveSignalColor  := #ef4444
else if isBuyRealtimeCandidate
    string curBuyType = isUltraSniperMode ? 'BUY ULTRA-SNIPER 🎯' : (allowSniper and condBuySniper) ? 'BUY SNIPER 🎯' : (allowBreakout and condBuyBreakout) ? 'BUY BREAKOUT 🚀' : 'BUY PULLBACK 🟢'
    if barstate.isconfirmed or sigMode == 'Realtime Saat Candle Berjalan'
        liveSignalStatus := '🟢 ' + curBuyType + ' ✅'
        liveSignalColor  := #10b981
    else
        liveSignalStatus := '🟢 ' + curBuyType + ' (Lilin Aktif ⏳)'
        liveSignalColor  := #00e5ff
else if isSellRealtimeCandidate
    string curSellType = isUltraSniperMode ? 'SELL ULTRA-SNIPER 🎯' : (allowSniper and condSellSniper) ? 'SELL SNIPER 🎯' : (allowBreakout and condSellBreakout) ? 'SELL BREAKOUT 🚀' : 'SELL PULLBACK 🔴'
    if barstate.isconfirmed or sigMode == 'Realtime Saat Candle Berjalan'
        liveSignalStatus := '🔴 ' + curSellType + ' ✅'
        liveSignalColor  := #ef4444
    else
        liveSignalStatus := '🔴 ' + curSellType + ' (Lilin Aktif ⏳)'
        liveSignalColor  := #ff5252
else if touchRBS
    if hasBullPattern
        liveSignalStatus := '💎 PANTULAN RBS: ' + bullPatternName
        liveSignalColor  := #00e5ff
    else
        liveSignalStatus := '💎 RETEST RBS (Support Baru ⏳)'
        liveSignalColor  := #00e5ff
else if touchSBR
    if hasBearPattern
        liveSignalStatus := '💎 PENOLAKAN SBR: ' + bearPatternName
        liveSignalColor  := #ff9100
    else
        liveSignalStatus := '💎 RETEST SBR (Resistance Baru ⏳)'
        liveSignalColor  := #ff9100
else if isPullbackBuyZone
    if hasBullPattern
        liveSignalStatus := '🟡 PULLBACK: ' + bullPatternName + ' (Menunggu)'
        liveSignalColor  := #f59e0b
    else
        liveSignalStatus := '🟡 PULLBACK BUY (Menunggu Pola ⏳)'
        liveSignalColor  := #eab308
else if isPullbackSellZone
    if hasBearPattern
        liveSignalStatus := '🟡 PULLBACK: ' + bearPatternName + ' (Menunggu)'
        liveSignalColor  := #f59e0b
    else
        liveSignalStatus := '🟡 PULLBACK SELL (Menunggu Pola ⏳)'
        liveSignalColor  := #eab308
else if useHtfFilter and isHtfSideways
    liveSignalStatus := '⚪ HTF [' + htfTimeframe + '] SIDEWAYS (No Entry ⛔)'
    liveSignalColor  := #94a3b8
else if isEMASideways
    liveSignalStatus := '⚪ EMA SIDEWAYS (Tidak Ada Entry)'
    liveSignalColor  := #94a3b8
else if isWhipsaw125
    liveSignalStatus := '⚪ WHIPSAW 125 (Pasar Ranging)'
    liveSignalColor  := #94a3b8
else if isOverextendedBuy or isOverextendedSell
    liveSignalStatus := '⚪ OVEREXTENDED (Jauh dari EMA)'
    liveSignalColor  := #f59e0b
else
    liveSignalStatus := (close > ema125) ? '⚪ Bullish (Menunggu Koreksi)' : '⚪ Bearish (Menunggu Koreksi)'
    liveSignalColor  := #64748b


//+------------------------------------------------------------------+
//|            MODUL 10: ON-CHART HUD DASHBOARD TABLE                |
//+------------------------------------------------------------------+

var table hudTable = na

string dashPos = dashPosition == 'Top Left' ? position.top_left : dashPosition == 'Bottom Left' ? position.bottom_left : dashPosition == 'Bottom Right' ? position.bottom_right : position.top_right

if barstate.islast and showDashboard
    table.delete(hudTable)
    hudTable := table.new(dashPos, 2, 12, bgcolor = dashBgColor, border_color = color.new(#334155, 0), border_width = 1)

    // Header Dashboard
    table.cell(hudTable, 0, 0, 'SMC & TRIPLE EMA MASTER', bgcolor = color.new(#0f172a, 0), text_color = #f59e0b, text_size = size.small)
    table.cell(hudTable, 1, 0, syminfo.ticker + ' [' + timeframe.period + ']', bgcolor = color.new(#0f172a, 0), text_color = #38bdf8, text_size = size.small)

    // Baris 1: Bias Tren HTF (Multi-Timeframe Scalping Rule 1)
    string htfTrendText  = not useHtfFilter ? 'FILTER NONAKTIF' : isHtfBull ? 'BULLISH 🟢 (Hanya BUY)' : isHtfBear ? 'BEARISH 🔴 (Hanya SELL)' : 'SIDEWAYS ⚪ (Dilarang Entry ⛔)'
    color  htfTrendColor = not useHtfFilter ? #94a3b8 : isHtfBull ? #10b981 : isHtfBear ? #ef4444 : #f59e0b
    table.cell(hudTable, 0, 1, 'HTF Bias [' + htfTimeframe + ']:', text_color = dashTextColor, text_size = size.small)
    table.cell(hudTable, 1, 1, htfTrendText, text_color = htfTrendColor, text_size = size.small)

    // Baris 2: Status Triple EMA & Koreksi Pullback (Rule 5)
    string emaTrendText = isEMASideways ? 'SIDEWAYS CHOP' : isPullbackBuyZone ? 'PULLBACK BUY (Peluang! 💎)' : isPullbackSellZone ? 'PULLBACK SELL (Peluang! 💎)' : (close > ema125 and ema8 > ema21 and ema21 > ema125) ? 'BULLISH (8 > 21 > 125)' : (close < ema125 and ema8 < ema21 and ema21 < ema125) ? 'BEARISH (8 < 21 < 125)' : 'TRANSITION'
    color  emaTrendColor = isEMASideways ? #f59e0b : (isPullbackBuyZone or (close > ema125 and ema8 > ema21)) ? #10b981 : (isPullbackSellZone or (close < ema125 and ema8 < ema21)) ? #ef4444 : #94a3b8
    table.cell(hudTable, 0, 2, 'Triple EMA Trend:', text_color = dashTextColor, text_size = size.small)
    table.cell(hudTable, 1, 2, emaTrendText, text_color = emaTrendColor, text_size = size.small)

    // Baris 3: Status Struktur Pasar
    color  structColor = (marketTrend == 1) ? color.green : (marketTrend == -1) ? color.red : color.gray
    string structText  = (lastStructName != 'None') ? lastStructName : (marketTrend == 1 ? 'BULLISH' : 'BEARISH')
    table.cell(hudTable, 0, 3, 'Market Structure:', text_color = dashTextColor, text_size = size.small)
    table.cell(hudTable, 1, 3, structText + (lastSwingStatus != 'None' ? ' (' + lastSwingStatus + ')' : ''), text_color = structColor, text_size = size.small)

    // Baris 4: Resistance Terdekat / Terkuat
    float  distRes = not na(majorResistance) ? (majorResistance - close) / syminfo.mintick / 10 : 0.0
    string resStr  = not na(majorResistance) ? str.tostring(majorResistance, '#.##') + ' (+' + str.tostring(distRes, '#.#') + ' pips)' : 'Scanning...'
    table.cell(hudTable, 0, 4, 'Major Resistance:', text_color = dashTextColor, text_size = size.small)
    table.cell(hudTable, 1, 4, resStr, text_color = #f43f5e, text_size = size.small)

    // Baris 5: Support Terdekat / Terkuat
    float  distSup = not na(majorSupport) ? (close - majorSupport) / syminfo.mintick / 10 : 0.0
    string supStr  = not na(majorSupport) ? str.tostring(majorSupport, '#.##') + ' (-' + str.tostring(distSup, '#.#') + ' pips)' : 'Scanning...'
    table.cell(hudTable, 0, 5, 'Major Support:', text_color = dashTextColor, text_size = size.small)
    table.cell(hudTable, 1, 5, supStr, text_color = #10b981, text_size = size.small)

    // Baris 6: Fibo Golden Zone Status Realtime (BUY vs SELL)
    string fiboText = ''
    color  fiboClr  = #94a3b8
    if inGoldenZone
        if isFiboForSell
            fiboText := 'GOLDEN POCKET (SELL OTE 🔴)'
            fiboClr  := #fb7185
        else
            fiboText := 'GOLDEN POCKET (BUY OTE 🟢)'
            fiboClr  := #34d399
    else if isFiboBroken
        fiboText := isFiboForSell ? 'SELL Fibo Jebol (Buyer Kuat 🚀)' : 'BUY Fibo Jebol (Seller Kuat 💥)'
        fiboClr  := #f59e0b
    else
        bool isPremium = (close > fiboHighVal - fiboDiff * 0.5)
        if isFiboForSell
            fiboText := isPremium ? 'Premium (Ideal SELL 🔴)' : 'Discount (Target TP SELL 🎯)'
            fiboClr  := isPremium ? #f43f5e : #38bdf8
        else
            fiboText := isPremium ? 'Premium (Target TP BUY 🎯)' : 'Discount (Ideal BUY 🟢)'
            fiboClr  := isPremium ? #38bdf8 : #10b981
    table.cell(hudTable, 0, 6, 'Fibonacci Zone:', text_color = dashTextColor, text_size = size.small)
    table.cell(hudTable, 1, 6, fiboText, text_color = fiboClr, text_size = size.small)

    // Baris 7: Unmitigated OBs & FVGs
    table.cell(hudTable, 0, 7, 'Active OBs / FVGs:', text_color = dashTextColor, text_size = size.small)
    table.cell(hudTable, 1, 7, str.tostring(unmitigatedOBCount) + ' OBs | ' + str.tostring(unmitigatedFVGCount) + ' FVGs', text_color = #38bdf8, text_size = size.small)

    // Baris 8: Liquiditas Institusional (IDM & SSS Sweeps)
    string liqText = 'Pool Bersih (No Sweep)'
    color  liqClr  = #94a3b8
    if isSSLSweep or isSSLSweep[1] or isSSLSweep[2]
        liqText := 'SSL SWEPT 🎯 (Bullish Fuel)'
        liqClr  := #10b981
    else if isBSLSweep or isBSLSweep[1] or isBSLSweep[2]
        liqText := 'BSL SWEPT 🎯 (Bearish Fuel)'
        liqClr  := #ef4444
    else if marketTrend == 1 and not na(activeBullIDM)
        liqText := isBullIDMSwept ? 'Bull IDM Swept ⚡ (Fuel Ready)' : ('Bull IDM: ' + str.tostring(activeBullIDM, '#.##') + ' ⏳')
        liqClr  := isBullIDMSwept ? #10b981 : #fbbf24
    else if marketTrend == -1 and not na(activeBearIDM)
        liqText := isBearIDMSwept ? 'Bear IDM Swept ⚡ (Fuel Ready)' : ('Bear IDM: ' + str.tostring(activeBearIDM, '#.##') + ' ⏳')
        liqClr  := isBearIDMSwept ? #ef4444 : #fbbf24
    table.cell(hudTable, 0, 8, 'Liquidity / SSS:', text_color = dashTextColor, text_size = size.small)
    table.cell(hudTable, 1, 8, liqText, text_color = liqClr, text_size = size.small)

    // Baris 9: False Signal Watchdog
    string watchdogStr = isEMASideways ? 'Warning: EMA Sideways' : isWhipsaw125 ? 'Warning: Whipsaw EMA 125' : (isOverextendedBuy or isOverextendedSell) ? 'Warning: Overextended' : 'Clear (No Warnings)'
    color  watchdogClr = (isEMASideways or isWhipsaw125 or isOverextendedBuy or isOverextendedSell) ? #f59e0b : #10b981
    table.cell(hudTable, 0, 9, 'Market Safety:', text_color = dashTextColor, text_size = size.small)
    table.cell(hudTable, 1, 9, watchdogStr, text_color = watchdogClr, text_size = size.small)

    // Baris 10: Realtime Signal Lilin Aktif (Detik Ini)
    table.cell(hudTable, 0, 10, 'Realtime Signal:', text_color = dashTextColor, text_size = size.small)
    table.cell(hudTable, 1, 10, liveSignalStatus, text_color = liveSignalColor, text_size = size.small)

    // Baris 11: Sinyal Terkonfirmasi Terakhir (Confirmed Setup)
    string confStr = not na(lastConfirmedSignalBar) ? lastConfirmedSignalText + ' (' + str.tostring(bar_index - lastConfirmedSignalBar) + ' bar lalu)' : 'Belum Ada Sinyal'
    table.cell(hudTable, 0, 11, 'Confirmed Entry:', text_color = dashTextColor, text_size = size.small)
    table.cell(hudTable, 1, 11, confStr, text_color = lastConfirmedSignalColor, text_size = size.small)


//+------------------------------------------------------------------+
//|            MODUL 11: SISTEM NOTIFIKASI & ALERTS                  |
//+------------------------------------------------------------------+

// 1. Alert Break of Structure & Change of Character
alertcondition(bullBreak and marketTrend == 1, 'Bullish BOS Alert', 'SMC Alert: Bullish BOS Terkonfirmasi menembus Swing High!')
alertcondition(bullBreak and marketTrend != 1, 'Bullish CHoCH Alert', 'SMC Alert: Bullish CHoCH Reversal Terkonfirmasi!')
alertcondition(bearBreak and marketTrend == -1, 'Bearish BOS Alert', 'SMC Alert: Bearish BOS Terkonfirmasi menembus Swing Low!')
alertcondition(bearBreak and marketTrend != -1, 'Bearish CHoCH Alert', 'SMC Alert: Bearish CHoCH Reversal Terkonfirmasi!')

// 2. Alert Sentuhan S/R Kuat
alertcondition(ta.cross(close, majorResistance), 'Touch Major Resistance', 'S/R Alert: Harga menyentuh Major Resistance Terkuat!')
alertcondition(ta.cross(close, majorSupport), 'Touch Major Support', 'S/R Alert: Harga menyentuh Major Support Terkuat!')

// 3. Alert Masuk Golden Zone Fibo
alertcondition(inGoldenZone and not inGoldenZone[1], 'Enter Golden Zone', 'Fibo Alert: Harga memasuki Fibonacci Golden Pocket (0.50 - 0.65 OTE)!')

// 4. Alert Breakout Valid & False Breakout (Rules 1, 2, 3, 4)
alertcondition(validBreakoutBuy, 'Valid Breakout Resistance (BUY)', 'S/R Alert: Valid Body Breakout Resistance Terkonfirmasi!')
alertcondition(validBreakoutSell, 'Valid Breakout Support (SELL)', 'S/R Alert: Valid Body Breakout Support Terkonfirmasi!')
alertcondition(isResistanceFakeout, 'False Breakout Resistance (Fakeout)', 'Fakeout Alert: Terdeteksi Wick Sweep / Fakeout di Resistance!')
alertcondition(isSupportFakeout, 'False Breakout Support (Fakeout)', 'Fakeout Alert: Terdeteksi Wick Sweep / Fakeout di Support!')

// 5. Alert Sinyal BUY & SELL Konfirmasi (Semua Engine)
alertcondition(buySignal, 'BUY Entry Signal (All Engines)', '🟢 BUY Entry Signal Terkonfirmasi! Ticker: {{ticker}}, Harga: {{close}}')
alertcondition(sellSignal, 'SELL Entry Signal (All Engines)', '🔴 SELL Entry Signal Terkonfirmasi! Ticker: {{ticker}}, Harga: {{close}}')

// 6. Alert Role Reversal (RBS & SBR)
alertcondition(touchRBS, 'Retest RBS (Support Baru)', 'Role Reversal Alert: Harga me-retest level RBS (Resistance Became Support)!')
alertcondition(touchSBR, 'Retest SBR (Resistance Baru)', 'Role Reversal Alert: Harga me-retest level SBR (Support Became Resistance)!')

// 7. Alert Liquiditas Institusional (IDM & SSS Sweeps)
alertcondition(isBSLSweep, 'SSS BSL Liquidity Sweep', 'SMC Alert: BSL (Buy-Side Liquidity) Sweep Terdeteksi! Rejection di atas Swing High/Resistance!')
alertcondition(isSSLSweep, 'SSS SSL Liquidity Sweep', 'SMC Alert: SSL (Sell-Side Liquidity) Sweep Terdeteksi! Rejection di bawah Swing Low/Support!')
alertcondition(justBullIDMSwept, 'Bullish IDM Swept', 'SMC Alert: Bullish Inducement (IDM) Swept! Liquidity diambil, siap pantulan Demand/Fibo!')
alertcondition(justBearIDMSwept, 'Bearish IDM Swept', 'SMC Alert: Bearish Inducement (IDM) Swept! Liquidity diambil, siap penolakan Supply/Fibo!')

// 8. Alert Spesifik SMC Sniper & Breakout Momentum
alertcondition(isBuySniperActive and triggerReady, 'BUY Sniper Reversal Signal', '🎯 BUY Sniper Reversal Terkonfirmasi di Zona Demand/Fibo/Sweep! Ticker: {{ticker}}, Harga: {{close}}')
alertcondition(isSellSniperActive and triggerReady, 'SELL Sniper Reversal Signal', '🎯 SELL Sniper Reversal Terkonfirmasi di Zona Supply/Fibo/Sweep! Ticker: {{ticker}}, Harga: {{close}}')
alertcondition(isBuyBreakoutActive and triggerReady, 'BUY Breakout Momentum Signal', '🚀 BUY Breakout Momentum Terkonfirmasi Tembus Resistance! Ticker: {{ticker}}, Harga: {{close}}')
alertcondition(isSellBreakoutActive and triggerReady, 'SELL Breakout Momentum Signal', '🚀 SELL Breakout Momentum Terkonfirmasi Tembus Support! Ticker: {{ticker}}, Harga: {{close}}')
