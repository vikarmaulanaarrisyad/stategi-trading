//@version=6
// ==============================================================================
// Author: Vikar Strategy
// Name: VIKAR - 4-Pillar Unified Strategy: SMC Core + S/R + Triple EMA + Fibonacci Pro
// Description: Smart Money Concepts (BOS/CHoCH, Liquidity Sweeps, Fractals) as Core,
//              Triple EMA (8, 21, 125) with Dynamic Ribbon & Trailing Stop,
//              Support & Resistance (Multi-Timeframe Pivot Points & 3 Key Levels),
//              Auto-Fibonacci Retracement & Golden Pocket (0.500, 0.618, 0.786) & Extensions,
//              18-Candlestick Pullback Rejection Signals, Clean Chart Mode, HUD Dashboard, and Alerts.
// Language: Pine Script v6
// ==============================================================================

indicator("VIKAR - 4-Pillar Strategy [SMC + S/R + EMA + Fibo] Pro", "VIKAR 4-Pillar Pro", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ==============================================================================
// 1. TRIPLE EMA INPUTS & SETTINGS (SOP VIKAR)
// ==============================================================================
string GRP_EMA       = "Triple Exponential Moving Averages (EMA)"
series float srcEMA  = input.source(close,        "EMA Price Source",             group = GRP_EMA)

bool   showEma8      = input.bool(true,           "",                             inline = "ema1", group = GRP_EMA)
int    lenEma8       = input.int(8,               "EMA Fast (8)   ",              inline = "ema1", minval = 1, group = GRP_EMA)
color  colEma8       = input.color(#00E5FF,       "",                             inline = "ema1", group = GRP_EMA) // Cyan Electric
int    wEma8         = input.int(2,               "Width",                        inline = "ema1", minval = 1, maxval = 4, group = GRP_EMA)

bool   showEma21     = input.bool(true,           "",                             inline = "ema2", group = GRP_EMA)
int    lenEma21      = input.int(21,              "EMA Mid (21)   ",               inline = "ema2", minval = 1, group = GRP_EMA)
color  colEma21      = input.color(#FF007F,       "",                             inline = "ema2", group = GRP_EMA) // Magenta / Fuchsia
int    wEma21        = input.int(2,               "Width",                        inline = "ema2", minval = 1, maxval = 4, group = GRP_EMA)

bool   showEma125    = input.bool(true,           "",                             inline = "ema3", group = GRP_EMA)
int    lenEma125     = input.int(125,             "EMA Trend (125)",              inline = "ema3", minval = 1, group = GRP_EMA)
color  colEma125     = input.color(#FFFFFF,       "",                             inline = "ema3", group = GRP_EMA) // White Institutional Baseline
int    wEma125       = input.int(3,               "Width",                        inline = "ema3", minval = 1, maxval = 4, group = GRP_EMA)

bool   showValueZone = input.bool(true,           "Highlight 8-21 Pullback Zone", group = GRP_EMA, tooltip = "Memberikan shading warna antara EMA 8 dan 21 sebagai Value Zone pullback.")

// ==============================================================================
// 2. TRIPLE EMA CALCULATIONS & PLOTS
// ==============================================================================
float ema8   = ta.ema(srcEMA, lenEma8)
float ema21  = ta.ema(srcEMA, lenEma21)
float ema125 = ta.ema(srcEMA, lenEma125)

pEma8   = plot(showEma8   ? ema8   : na, "EMA Fast (8)",   color = colEma8,   linewidth = wEma8)
pEma21  = plot(showEma21  ? ema21  : na, "EMA Mid (21)",   color = colEma21,  linewidth = wEma21)
plot(showEma125 ? ema125 : na, "EMA Trend (125)", color = colEma125, linewidth = wEma125)

// Fill Value Zone (Pullback Ribbon antara EMA 8 dan EMA 21)
color fillBullish = color.new(#00E5FF, 85)
color fillBearish = color.new(#FF007F, 85)
color zoneColor   = ema8 >= ema21 ? fillBullish : fillBearish
fill(pEma8, pEma21, color = (showValueZone and showEma8 and showEma21) ? zoneColor : na, title = "EMA 8-21 Value Zone")

// ==============================================================================
// 3. PIVOT POINTS CONFIGURATION & INPUTS
// ==============================================================================
string TT_DB = (
    "When not selected, the indicator uses intraday data instead of EOD data on intraday charts. If the chart includes "
    + "data from extended hours, the pivot level calculation takes that data into account. If intraday OHLC values "
    + "differ from EOD values (normal for stocks), the calculated pivot levels will also differ."
)
DW = display.data_window

string GRP_PIV_CFG              = "Pivot General Settings"
string pivotTypeInput           = input.string("Traditional", "Type",                   options = ["Traditional", "Fibonacci", "Woodie", "Classic", "DM", "Camarilla"], group = GRP_PIV_CFG)
string pivotAnchorInput         = input.string("Auto",        "Pivots timeframe",       options = ["Auto", "Daily", "Weekly", "Monthly", "Quarterly", "Yearly", "Biyearly", "Triyearly", "Quinquennially", "Decennially"], group = GRP_PIV_CFG)
bool   isDailyBasedInput        = input.bool(true,            "Use daily-based values", tooltip = TT_DB, group = GRP_PIV_CFG, display = DW)

string GRP_CLEAN                = "Pivot Clean Chart Mode"
bool   onlyCurrentPivot         = input.bool(true,            "Hanya Pivot Periode Aktif (Clean Chart)", group = GRP_CLEAN, tooltip = "Hanya menampilkan garis pivot yang sedang aktif berjalan sehingga chart tidak penuh dengan garis historis lama.")
bool   extendCurrentLines       = input.bool(true,            "Panjangkan Garis ke Kanan (Extend Right)", group = GRP_CLEAN, tooltip = "Garis level pivot aktif diperpanjang ke kanan melintasi bar harga.")
int    maxHistoricalPivotsInput = input.int(15,               "Number of historical pivots back", 1, 200, group = GRP_CLEAN, display = DW, active = not onlyCurrentPivot)

string GRP01                    = "Pivot Labels"
